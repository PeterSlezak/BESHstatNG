<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Both pane locales must be available even when Office and browser cultures differ. -->
    <EmbeddedResource Update="Resources\Ui.sk.resx" WithCulture="false" LogicalName="BESHStat.OfficeAddin.Resources.Ui.sk.resources" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <ProjectReference Include="..\BESHStat.Core\BESHStat.Core.vbproj" />
    <ProjectReference Include="..\BESHStat.Excel.Common\BESHStat.Excel.Common.vbproj" />
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>
</Project>
