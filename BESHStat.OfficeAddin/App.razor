@implements IAsyncDisposable
@inject IOfficeHostReadiness Host
@inject IFoundationProbe Probe
@inject BESHStat.OfficeAddin.Services.IWorkbookAdapter Workbook
@inject BESHStat.OfficeAddin.Services.WorkbookDiagnostics ReadDiagnostics
@inject OfficePreferenceSession Preferences
@inject OfficeStrings Text
@inject BESHStatNG.ExcelCommon.DiagnosticEmitter Diagnostics

<main>
    <header class="workspace-header">
    <h1>BESHStatNG <small>Office workspace</small></h1>
    <p>Development build - 04.06</p>
    <div class="availability" role="status">
        <span>@(loading ? Text["Connecting"] : status.IsExcel ? Text["ExcelReady"] : status.Message)</span>
        <button id="retry-initialization" @onclick="RetryAsync" disabled="@(loading || reading || pilotBusy || Preferences.Applying)">@Text["Retry"]</button>
    </div>
    <div role="tablist" aria-label="@Text["WorkspaceViews"]" class="workspace-tabs">
        <button @ref="analysisTab" id="analysis-tab" role="tab" aria-selected="@Selected(0)" aria-controls="analysis-panel" tabindex="@(activeTab == 0 ? 0 : -1)" @onclick="() => activeTab = 0" @onkeydown="TabKey">@Text["Analysis"]</button>
        <button @ref="optionsTab" id="options-tab" role="tab" aria-selected="@Selected(1)" aria-controls="options-panel" tabindex="@(activeTab == 1 ? 0 : -1)" @onclick="() => activeTab = 1" @onkeydown="TabKey">@Text["Options"]</button>
        <button @ref="logTab" id="diagnostics-tab" role="tab" aria-selected="@Selected(2)" aria-controls="diagnostics-panel" tabindex="@(activeTab == 2 ? 0 : -1)" @onclick="() => activeTab = 2" @onkeydown="TabKey">@Text["Diagnostics"]</button>
    </div>
    </header>
    <div id="analysis-panel" role="tabpanel" aria-labelledby="analysis-tab" tabindex="0" hidden="@(activeTab != 0)">
        @if (Preferences.Initialized)
        { <fieldset disabled="@Preferences.Applying" class="workspace-analysis"><AnalysisShell HostAvailable="@(!loading && status.IsExcel)" ReadinessGeneration="readinessGeneration" BusyChanged="busy => pilotBusy = busy" /></fieldset> }
        <p class="workspace-note">Workbook reads and output writes require explicit actions. Raw input values, names and addresses are hidden from diagnostics.</p>
        <HelpAction />
    </div>
    <div id="options-panel" role="tabpanel" aria-labelledby="options-tab" tabindex="0" hidden="@(activeTab != 1)"><GlobalOptions /></div>
    <div id="diagnostics-panel" role="tabpanel" aria-labelledby="diagnostics-tab" tabindex="0" hidden="@(activeTab != 2)">
    <DiagnosticLog />
    @if (ReadDiagnostics.Enabled)
    {
    <section aria-live="polite" aria-busy="@loading.ToString().ToLowerInvariant()">
        <h2>Office host</h2>
        <p id="host-status">@(loading ? "Waiting for Office initialization..." : status.Message)</p>
        @if (!loading)
        {
            <p>Diagnostic: <code id="host-code">@status.Code</code></p>
            @if (status.Platform.Length > 0) { <p>Platform: @status.Platform</p> }
        }
    </section>
    <section>
        <h2>Core and Common checks</h2>
        @if (probe is null) { <p>Loading local probes...</p> }
        else
        {
            <p id="core-probe">Core: @(probe.CorePassed ? "passed" : "failed") - standard normal CDF(0) = @probe.NormalCdf.ToString("G17", System.Globalization.CultureInfo.InvariantCulture)</p>
            <p id="common-probe">Common: @(probe.CommonPassed ? "passed" : "failed") - @probe.DescriptorCount descriptors, @probe.HandlerCount registered handlers</p>
            <p>Diagnostic: <code>@probe.Code</code></p>
        }
    </section>
    @if (!loading && status.IsExcel && ReadDiagnostics.Enabled)
    {
        <section aria-live="polite" aria-busy="@reading.ToString().ToLowerInvariant()">
            <h2>Read-only development check</h2>
            <button @onclick="InspectAsync" disabled="@(reading || pilotBusy)">Read selected range (read-only)</button>
            @if (ReadDiagnostics.Enabled)
            {
                <button @onclick="InspectMetadataAsync" disabled="@(reading || pilotBusy)">Inspect selection metadata only (read-only)</button>
            }
            @if (readCode is not null) { <p id="range-status">Status: @readCode</p> }
            @if (rangeRows > 0) { <p>@rangeRows rows by @rangeColumns columns - @((long)rangeRows * rangeColumns) cells</p> }
        </section>
    }
    @if (ReadDiagnostics.Enabled)
    {
        <section aria-label="Local development read stages">
            <h2>Local development read stages</h2>
            <button @onclick="RefreshStages">Refresh stage summary</button>
            <pre id="development-stage-summary">@stageSummary</pre>
        </section>
    }
    }
    </div>
</main>

@code {
    private readonly CancellationTokenSource lifetime = new();
    private HostStatus status = HostStatus.Unavailable;
    private ProbeResult? probe;
    private bool loading = true;
    private bool disposed;
    private bool reading;
    private bool pilotBusy;
    private int activeTab;
    private ElementReference analysisTab, optionsTab, logTab;
    private string Selected(int tab) => (activeTab == tab).ToString().ToLowerInvariant();
    private async Task TabKey(KeyboardEventArgs e)
    {
        if (e.Key is not ("ArrowLeft" or "ArrowRight" or "Home" or "End")) return;
        activeTab = e.Key switch { "Home" => 0, "End" => 2, "ArrowRight" => (activeTab + 1) % 3, _ => (activeTab + 2) % 3 };
        try { await (activeTab switch { 0 => analysisTab, 1 => optionsTab, _ => logTab }).FocusAsync(); } catch (InvalidOperationException) { }
    }
    private int readinessGeneration;
    private string? readCode;
    private int rangeRows, rangeColumns;
    private string stageSummary = "";
    private void RefreshStages() => stageSummary = string.Join("\n", ReadDiagnostics.Snapshot().Select(e => $"{e.Code} {e.ElapsedMs}ms"));

    private async Task InspectMetadataAsync()
    {
        if (reading || pilotBusy || !status.IsExcel || disposed || !ReadDiagnostics.Enabled) return;
        reading = true;
        readCode = null;
        rangeRows = rangeColumns = 0;
        var result = await Workbook.InspectSelectionAsync(lifetime.Token);
        if (disposed) return;
        readCode = result.Code;
        if (result.Succeeded) { rangeRows = result.Value!.RowCount; rangeColumns = result.Value.ColumnCount; }
        reading = false;
        RefreshStages();
    }

    private async Task InspectAsync()
    {
        if (reading || pilotBusy || !status.IsExcel || disposed || !ReadDiagnostics.Enabled) return;
        reading = true;
        readCode = null;
        rangeRows = rangeColumns = 0;
        var result = await Workbook.ReadSelectionAsync(cancellationToken: lifetime.Token);
        if (disposed) return;
        readCode = result.Code;
        if (result.Succeeded) { rangeRows = result.Value!.RowCount; rangeColumns = result.Value.ColumnCount; }
        reading = false;
        RefreshStages();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await StartAsync(false);
    }

    private Task RetryAsync() => StartAsync(true);

    private async Task StartAsync(bool retry)
    {
        Text.Changed -= RefreshPreferences;
        Text.Changed += RefreshPreferences;
        await Text.InitializeAsync();
        await Preferences.InitializeAsync();
        Preferences.Changed -= RefreshPreferences;
        Preferences.Changed += RefreshPreferences;
        var diagnostic = await Diagnostics.StartAsync("office", Preferences.Effective.TraceEnabled);
        if (retry) await diagnostic.ReportAsync("diagnostic.host.retry", "invocation");
        if (retry) readinessGeneration++;
        loading = true;
        readCode = null;
        rangeRows = rangeColumns = 0;
        // Render waiting state before asynchronous Office readiness.
        StateHasChanged();
        probe = Probe.Run();
        var result = await Host.InitializeAsync(lifetime.Token, retry);
        if (disposed) return;
        status = result;
        await diagnostic.ReportAsync(result.IsExcel ? "diagnostic.host.ready" : "diagnostic.host.unavailable", "invocation");
        await diagnostic.EndAsync();
        loading = false;
        StateHasChanged();
    }

    private void RefreshPreferences() { if (!disposed) _ = InvokeAsync(StateHasChanged); }

    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        Preferences.Changed -= RefreshPreferences;
        Text.Changed -= RefreshPreferences;
        lifetime.Cancel();
        await Workbook.DisposeAsync();
        await Host.DisposeAsync();
        lifetime.Dispose();
    }
}
