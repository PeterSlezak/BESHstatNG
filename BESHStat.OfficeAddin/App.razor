@implements IAsyncDisposable
@inject IOfficeHostReadiness Host
@inject IFoundationProbe Probe
@inject BESHStat.OfficeAddin.Services.IWorkbookAdapter Workbook
@inject BESHStat.OfficeAddin.Services.WorkbookDiagnostics ReadDiagnostics
@inject OfficePreferenceSession Preferences
@inject OfficeStrings Text
@inject BESHStatNG.ExcelCommon.DiagnosticEmitter Diagnostics
@inject OfficeCommandCoordinator Commands
@inject IOfficeCommandBridge CommandBridge
@inject OfficeHelp Help

<main>
    <header class="workspace-header">
    <h1 class="visually-hidden">BESHStatNG @Text["OfficeWorkspace"]</h1>
    <div class="workspace-menu">
        <span class="workspace-build">@Text["DevelopmentBuild"] - @DevelopmentBatch</span>
        <nav aria-label="@Text["WorkspaceMenu"]">
            <button @ref="aboutHeader" id="header-about" type="button" class="menu-link" aria-haspopup="dialog" @onclick="OpenHeaderAboutAsync">@Text["AboutCommand"]</button>
            <HelpAction Id="header-help" Label="@Text["HelpHomeCommand"]" />
        </nav>
    </div>
    <div role="tablist" aria-label="@Text["WorkspaceViews"]" class="workspace-tabs">
        <button @ref="analysisTab" id="analysis-tab" role="tab" aria-selected="@Selected(0)" aria-controls="analysis-panel" tabindex="@(activeTab == 0 ? 0 : -1)" @onclick="() => activeTab = 0" @onkeydown="TabKey">@Text["Analysis"]</button>
        <button @ref="optionsTab" id="options-tab" role="tab" aria-selected="@Selected(1)" aria-controls="options-panel" tabindex="@(activeTab == 1 ? 0 : -1)" @onclick="() => activeTab = 1" @onkeydown="TabKey">@Text["Options"]</button>
        <button @ref="exportTab" id="export-tab" role="tab" aria-selected="@Selected(2)" aria-controls="export-panel" tabindex="@(activeTab == 2 ? 0 : -1)" @onclick="() => activeTab = 2" @onkeydown="TabKey">@Text["ExportChart"]</button>
        <button @ref="logTab" id="diagnostics-tab" role="tab" aria-selected="@Selected(3)" aria-controls="diagnostics-panel" tabindex="@(activeTab == 3 ? 0 : -1)" @onclick="() => activeTab = 3" @onkeydown="TabKey">@Text["Diagnostics"]</button>
    </div>
    </header>
    @if (Commands.Code.Length > 0) { <p id="command-status" role="status">@Text[Commands.Code switch { "command.navigated" => "CommandSelected", "command.busy" => "CommandBusy", "command.unavailable" => "CommandUnavailable", "command.host-unsupported" => "CommandHostUnsupported", _ => "CommandRejected" }]</p> }
    <div id="analysis-panel" role="tabpanel" aria-labelledby="analysis-tab" tabindex="0" hidden="@(activeTab != 0)">
        @if (Preferences.Initialized)
        { <fieldset disabled="@Preferences.Applying" class="workspace-analysis"><AnalysisShell @ref="shell" HostAvailable="@(!loading && status.IsExcel)" ReadinessGeneration="readinessGeneration" BusyChanged="busy => pilotBusy = busy" /></fieldset> }
        <p class="workspace-note">Workbook reads and output writes require explicit actions. Raw input values, names and addresses are hidden from diagnostics.</p>
    </div>
    <div id="options-panel" role="tabpanel" aria-labelledby="options-tab" tabindex="0" hidden="@(activeTab != 1)"><GlobalOptions /></div>
    <div id="export-panel" role="tabpanel" aria-labelledby="export-tab" tabindex="0" hidden="@(activeTab != 2)">
        <section aria-labelledby="export-title">
            <h2 id="export-title">@Text["ExportChart"]</h2>
            <p id="export-placeholder">@Text["ExportPlaceholder"]</p>
            <HelpAction Id="export-help" PageKey="ExportChart" Label="@Text["ExportHelp"]" />
        </section>
    </div>
    <div id="diagnostics-panel" role="tabpanel" aria-labelledby="diagnostics-tab" tabindex="0" hidden="@(activeTab != 3)">
    <section class="host-connection" aria-labelledby="host-connection-title" aria-busy="@loading.ToString().ToLowerInvariant()">
        <h2 id="host-connection-title">@Text["OfficeConnection"]</h2>
        <div class="availability" role="status">
            <span id="host-availability">@(loading ? Text["Connecting"] : status.IsExcel ? Text["ExcelReady"] : status.Message)</span>
            <button id="retry-initialization" type="button" @onclick="RetryAsync" disabled="@(loading || reading || pilotBusy || Preferences.Applying)">@Text["Retry"]</button>
        </div>
        @if (ReadDiagnostics.Enabled)
        {
            <p id="host-status">@(loading ? "Waiting for Office initialization..." : status.Message)</p>
            @if (!loading)
            {
                <p>Diagnostic: <code id="host-code">@status.Code</code></p>
                @if (status.Platform.Length > 0) { <p>Platform: @status.Platform</p> }
            }
        }
    </section>
    <DiagnosticLog />
    @if (ReadDiagnostics.Enabled)
    {
    <section>
        <h2>Core and Common checks</h2>
        @if (probe is null) { <p>Loading local probes...</p> }
        else
        {
            <p id="core-probe">Core: @(probe.CorePassed ? "passed" : "failed") - standard normal CDF(0) = @probe.NormalCdf.ToString("G17", System.Globalization.CultureInfo.InvariantCulture)</p>
            <p id="common-probe">Common: @(probe.CommonPassed ? "passed" : "failed") - @probe.DescriptorCount descriptors, @probe.HandlerCount registered handlers</p>
            <p>Diagnostic: <code>@probe.Code</code></p>
        }
    </section>
    @if (!loading && status.IsExcel && ReadDiagnostics.Enabled)
    {
        <section aria-live="polite" aria-busy="@reading.ToString().ToLowerInvariant()">
            <h2>Read-only development check</h2>
            <button @onclick="InspectAsync" disabled="@(reading || pilotBusy)">Read selected range (read-only)</button>
            @if (ReadDiagnostics.Enabled)
            {
                <button @onclick="InspectMetadataAsync" disabled="@(reading || pilotBusy)">Inspect selection metadata only (read-only)</button>
            }
            @if (readCode is not null) { <p id="range-status">Status: @readCode</p> }
            @if (rangeRows > 0) { <p>@rangeRows rows by @rangeColumns columns - @((long)rangeRows * rangeColumns) cells</p> }
        </section>
    }
    @if (ReadDiagnostics.Enabled)
    {
        <section aria-label="Local development read stages">
            <h2>Local development read stages</h2>
            <button @onclick="RefreshStages">Refresh stage summary</button>
            <pre id="development-stage-summary">@stageSummary</pre>
        </section>
    }
    }
    </div>
    @if (aboutOpen)
    {
        <dialog class="about-dialog" role="dialog" aria-modal="true" aria-labelledby="about-title" id="about-panel" @onkeydown="AboutKey">
            <h2 id="about-title">@Text["AboutCommand"]</h2>
            <p>BESHStatNG · @Text["OfficeWorkspace"]</p>
            <p>@Text["DevelopmentBuild"] - @DevelopmentBatch</p>
            <p>@Help.Version.DisplayLabel</p><p>@Text["AboutBuild"]</p><p>@Text["AboutPlatform"]: @(status.Platform.Length == 0 ? Text["UnknownPlatform"] : status.Platform)</p>
            <p id="about-license">@Text["AboutLicense"]</p>
            <p>@Text["AboutMethods"]</p><HelpAction Label="@Text["Documentation"]" />
            <button @ref="aboutClose" id="about-close" @onclick="CloseAbout">@Text["Close"]</button>
        </dialog>
    }
</main>

@code {
    private const string DevelopmentBatch = "04.07";
    private readonly CancellationTokenSource lifetime = new();
    private HostStatus status = HostStatus.Unavailable;
    private ProbeResult? probe;
    private bool loading = true;
    private bool disposed;
    private bool reading;
    private bool pilotBusy;
    private int activeTab;
    private AnalysisShell? shell;
    private IDisposable? commandOwner;
    private bool aboutOpen, focusAbout, focusWorkspace;
    private bool headerAboutRequested, returnAboutToHeader;
    private ElementReference aboutClose, aboutHeader;
    protected override void OnInitialized()
    {
        commandOwner = Commands.Participate(() => !loading && !reading && !pilotBusy && !Preferences.Applying, NavigateCommandAsync);
        Commands.Changed += RefreshPreferences;
    }
    private async Task<bool> NavigateCommandAsync(OfficeCommand command)
    {
        if (disposed) return false;
        if (command.AnalysisId is { } id && (shell is null || !await shell.NavigateFromCommandAsync(id))) return false;
        if (command.Destination == "help") return await Help.OpenAsync(Help.Home) == "requested";
        aboutOpen = command.Destination == "about";
        focusAbout = aboutOpen;
        if (aboutOpen) returnAboutToHeader = headerAboutRequested;
        if (!aboutOpen) activeTab = command.Destination switch { "options" => 1, "diagnostics" => 3, _ => 0 };
        StateHasChanged(); return true;
    }
    private Task CloseAbout() { aboutOpen = false; focusWorkspace = true; return Task.CompletedTask; }
    private async Task OpenHeaderAboutAsync()
    {
        headerAboutRequested = true;
        try { await Commands.DispatchAsync("about"); } finally { headerAboutRequested = false; }
    }
    private Task AboutKey(KeyboardEventArgs e) => e.Key == "Escape" ? CloseAbout() : Task.CompletedTask;
    private async Task<string> DispatchRibbonAsync(string id) { var code = "command.rejected"; await InvokeAsync(async () => code = await Commands.DispatchAsync(id,true)); return code; }
    private ElementReference analysisTab, optionsTab, exportTab, logTab;
    private ElementReference ActiveTabReference => activeTab switch { 0 => analysisTab, 1 => optionsTab, 2 => exportTab, _ => logTab };
    private string Selected(int tab) => (activeTab == tab).ToString().ToLowerInvariant();
    private async Task TabKey(KeyboardEventArgs e)
    {
        if (e.Key is not ("ArrowLeft" or "ArrowRight" or "Home" or "End")) return;
        activeTab = e.Key switch { "Home" => 0, "End" => 3, "ArrowRight" => (activeTab + 1) % 4, _ => (activeTab + 3) % 4 };
        try { await ActiveTabReference.FocusAsync(); } catch (InvalidOperationException) { }
    }
    private int readinessGeneration;
    private string? readCode;
    private int rangeRows, rangeColumns;
    private string stageSummary = "";
    private void RefreshStages() => stageSummary = string.Join("\n", ReadDiagnostics.Snapshot().Select(e => $"{e.Code} {e.ElapsedMs}ms"));

    private async Task InspectMetadataAsync()
    {
        if (reading || pilotBusy || !status.IsExcel || disposed || !ReadDiagnostics.Enabled) return;
        reading = true;
        readCode = null;
        rangeRows = rangeColumns = 0;
        var result = await Workbook.InspectSelectionAsync(lifetime.Token);
        if (disposed) return;
        readCode = result.Code;
        if (result.Succeeded) { rangeRows = result.Value!.RowCount; rangeColumns = result.Value.ColumnCount; }
        reading = false;
        RefreshStages();
    }

    private async Task InspectAsync()
    {
        if (reading || pilotBusy || !status.IsExcel || disposed || !ReadDiagnostics.Enabled) return;
        reading = true;
        readCode = null;
        rangeRows = rangeColumns = 0;
        var result = await Workbook.ReadSelectionAsync(cancellationToken: lifetime.Token);
        if (disposed) return;
        readCode = result.Code;
        if (result.Succeeded) { rangeRows = result.Value!.RowCount; rangeColumns = result.Value.ColumnCount; }
        reading = false;
        RefreshStages();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await StartAsync(false);
        if (focusAbout) { focusAbout = false; await CommandBridge.ShowAboutAsync(); try { await aboutClose.FocusAsync(); } catch (InvalidOperationException) { } }
        if (focusWorkspace) { focusWorkspace = false; try { await (returnAboutToHeader ? aboutHeader : ActiveTabReference).FocusAsync(); } catch (InvalidOperationException) { } }
    }

    private Task RetryAsync() => StartAsync(true);

    private async Task StartAsync(bool retry)
    {
        Text.Changed -= RefreshPreferences;
        Text.Changed += RefreshPreferences;
        await Text.InitializeAsync();
        await Preferences.InitializeAsync();
        Preferences.Changed -= RefreshPreferences;
        Preferences.Changed += RefreshPreferences;
        var diagnostic = await Diagnostics.StartAsync("office", Preferences.Effective.TraceEnabled);
        if (retry) await diagnostic.ReportAsync("diagnostic.host.retry", "invocation");
        if (retry) readinessGeneration++;
        loading = true;
        readCode = null;
        rangeRows = rangeColumns = 0;
        // Render waiting state before asynchronous Office readiness.
        StateHasChanged();
        probe = Probe.Run();
        var result = await Host.InitializeAsync(lifetime.Token, retry);
        if (disposed) return;
        status = result;
        var commandRuntime = await CommandBridge.BindAsync(DispatchRibbonAsync);
        if (disposed) { await diagnostic.EndAsync(); return; }
        Commands.Runtime = commandRuntime with { Excel = status.IsExcel };
        await diagnostic.ReportAsync(result.IsExcel ? "diagnostic.host.ready" : "diagnostic.host.unavailable", "invocation");
        await diagnostic.EndAsync();
        loading = false;
        StateHasChanged();
        await CommandBridge.ReadyAsync();
    }

    private void RefreshPreferences() { if (!disposed) _ = InvokeAsync(StateHasChanged); }

    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        commandOwner?.Dispose(); Commands.Changed -= RefreshPreferences;
        await CommandBridge.DisposeAsync();
        Preferences.Changed -= RefreshPreferences;
        Text.Changed -= RefreshPreferences;
        lifetime.Cancel();
        await Workbook.DisposeAsync();
        await Host.DisposeAsync();
        lifetime.Dispose();
    }
}
