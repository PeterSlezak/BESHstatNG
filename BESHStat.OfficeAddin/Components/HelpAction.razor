@inject OfficeHelp Help
@inject OfficeStrings Text
@implements IDisposable
<span class="help-action">
    @* An ordinary hyperlink preserves the browser's user gesture in Excel Online.
       Office.context.ui.openBrowserWindow may not be available to task panes, and
       intercepted Blazor clicks are too late to reliably open new tabs. *@
    <a id="@Id" href="@LinkUrl" target="_blank" rel="noopener noreferrer">@(Label ?? Text["Help"])</a>
</span>
@code {
    [Parameter] public string? AnalysisId { get; set; }
    [Parameter] public bool GlobalSettings { get; set; }
    [Parameter] public string? PageKey { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Id { get; set; }
    private bool disposed;
    protected override void OnInitialized() => Text.Changed += Refresh;
    private void Refresh() { if (!disposed) _ = InvokeAsync(() => { if (!disposed) StateHasChanged(); }); }
    public void Dispose() { disposed = true; Text.Changed -= Refresh; }
    private BESHStatNG.ExcelCommon.HelpLaunchTarget Target => GlobalSettings ? Help.Settings : AnalysisId is { } id ? Help.Method(id) : PageKey is { } page ? Help.Page(page) : Help.Home;
    private string LinkUrl => BESHStatNG.ExcelCommon.HelpLaunchTarget.SafeOpenUrl(Target.Url);
}
