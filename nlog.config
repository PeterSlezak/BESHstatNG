<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      internalLogLevel="Info"
	  throwConfigExceptions="true">

	<!-- the targets to write to -->
	<targets>
		<!-- write logs to the files -->
		<target xsi:type="File" name="all_logs_file" fileName="${basedir}\Logs\all.log"/>
		<target xsi:type="File" name="err_file" fileName="${basedir}\Logs\err.log"/>
		<target xsi:type="File" name="logwarn_file" fileName="${basedir}\Logs\errwarn.log"/>
		<!-- write logs to the console-->
		<target xsi:type="ColoredConsole" name="logconsole" />
	</targets>

	<!-- rules to map from logger name to target -->
	<rules>
		<logger name="*" minlevel="Trace" writeTo="all_logs_file" />
		<logger name="*" minlevel="Warn" writeTo="logwarn_file" />
		<logger name="*" minlevel="Error" writeTo="err_file" />
	</rules>
</nlog>