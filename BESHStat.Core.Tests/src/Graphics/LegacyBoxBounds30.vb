Option Explicit On
Option Strict Off
Imports System
Imports System.Linq
Imports BESHStatNG
Namespace Global.Batch30Fixtures
Public Class LegacyBox30
    Friend pNoGroups As Integer, pData()() As Double, pNs() As Integer
    Friend pDSCollection As New Microsoft.VisualBasic.Collection
    Friend pPlotBlank(), pPlotMedian(), pPlotQ3(), pPlotQ3Minus(), pPlotMedianMinus(), pWhiskerQ3(), pWhiskerQ1(), pQ1(), pQ3(), pPlotMeans(), pMins(), pMaxs(), pMedians() As Double
    Friend pArNOutliersBig(), pArNOutliersSmall() As Long
        Sub CalcForPlotting()
            'Fit values for plotting (use values generated by Fit sub and modify them
            'COMPUTE VALUES FOR NEW BOX and WHISKERS CHARTS ACCORDING TO JOHN PELTIER
            'http://peltiertech.com/excel-box-and-whisker-diagrams-box-plots/

            Dim j As Long

            ReDim pPlotBlank(pNoGroups - 1), pPlotMedian(pNoGroups - 1), pPlotQ3(pNoGroups - 1)
            ReDim pPlotQ3Minus(pNoGroups - 1), pPlotMedianMinus(pNoGroups - 1), pWhiskerQ3(pNoGroups - 1)
            ReDim pWhiskerQ1(pNoGroups - 1), pQ1(pNoGroups - 1), pQ3(pNoGroups - 1), pPlotMeans(pNoGroups - 1)
            ReDim pMins(pNoGroups - 1), pMaxs(pNoGroups - 1), pMedians(pNoGroups - 1)

            For i = 0 To pNoGroups - 1

                With Me.pDSCollection.Item(i + 1) 'DescriptiveS
                    'Plot Blank

                    If .LQuartile > 0 Then
                        pPlotBlank(i) = .LQuartile
                    Else
                        pPlotBlank(i) = If(.UQuartile < 0, .UQuartile, 0)
                    End If

                    'Plot Median
                    If .Median > 0 Then
                        If .LQuartile > 0 Then
                            pPlotMedian(i) = If(.Median > .LQuartile, .Median - .LQuartile, 0)
                        Else
                            pPlotMedian(i) = .Median
                        End If
                    Else
                        pPlotMedian(i) = 0
                    End If

                    'Plot Q3
                    If .UQuartile > 0 Then
                        If .Median > 0 Then
                            pPlotQ3(i) = If(.UQuartile > .Median, .UQuartile - .Median, 0)
                        Else
                            pPlotQ3(i) = .UQuartile
                        End If
                    Else
                        pPlotQ3(i) = 0
                    End If

                    'Plot Q3 Minus
                    If .Median < 0 Then
                        If .UQuartile < 0 Then
                            pPlotQ3Minus(i) = If(.Median < .UQuartile, .Median - .UQuartile, 0)
                        Else
                            pPlotQ3Minus(i) = .Median
                        End If
                    Else
                        pPlotQ3Minus(i) = 0
                    End If

                    'Plot Median Minus
                    If .LQuartile < 0 Then
                        If .Median < 0 Then
                            pPlotMedianMinus(i) = If(.LQuartile < .Median, .LQuartile - .Median, 0)
                        Else
                            pPlotMedianMinus(i) = .LQuartile
                        End If
                    Else
                        pPlotMedianMinus(i) = 0
                    End If

                    'Sort a clone for whisker lookup so pData keeps the original
                    'observation order used by the optional jittered point layer.
                    Dim arTemporal() As Double = DirectCast(pData(i).Clone(), Double())
                    Array.Sort(arTemporal)

                    If .Maximum > .UQuartile Then
                        If pArNOutliersBig(i) = 0 Then
                            pWhiskerQ3(i) = .Maximum - .UQuartile
                        Else 'show outliers
                            For j = pNs(i) - 1 To pNs(i) / 2 - 1 Step -1
                                If (arTemporal(j) - (.UQuartile + 1.5 * .IQR)) <= 0 Then Exit For
                            Next
                            pWhiskerQ3(i) = arTemporal(j) - .UQuartile
                        End If
                    Else
                        pWhiskerQ3(i) = 0
                    End If

                    'Whisker Q1
                    If .LQuartile > .Minimum Then
                        If pArNOutliersSmall(i) = 0 Then
                            pWhiskerQ1(i) = .LQuartile - .Minimum
                        Else 'show outliers
                            For j = 0 To pNs(i) / 2 - 1
                                If (arTemporal(j) - (.LQuartile - 1.5 * .IQR)) >= 0 Then Exit For
                            Next
                            pWhiskerQ1(i) = .LQuartile - arTemporal(j)
                        End If
                    Else
                        pWhiskerQ1(i) = 0
                    End If

                    pQ1(i) = .LQuartile
                    pQ3(i) = .UQuartile
                    pPlotMeans(i) = .Mean
                    pMins(i) = .Minimum
                    pMaxs(i) = .Maximum
                    pMedians(i) = .Median
                End With
            Next i
        End Sub
End Class
Public Class LegacyHistogramBounds30
    Friend arBinMidVal() As Double
    Friend Function Compute() As Double()
        Dim iNoBins As Integer = Me.arBinMidVal.Length
            Dim dBinWidth As Double
            If iNoBins >= 2 Then
                dBinWidth = Math.Abs(Me.arBinMidVal(1) - Me.arBinMidVal(0))
            Else
                'Degenerate/one-bin case.  Exact width is not recoverable from the
                'midpoint alone, so use a stable symmetric display range.
                dBinWidth = Math.Max(1.0R, Math.Abs(Me.arBinMidVal(0))) * 2.0R
            End If
            If dBinWidth <= 0.0R OrElse Double.IsNaN(dBinWidth) OrElse Double.IsInfinity(dBinWidth) Then
                dBinWidth = 1.0R
            End If

            Dim dXMin As Double = Me.arBinMidVal(0) - dBinWidth / 2.0R
            Dim dXMax As Double = Me.arBinMidVal(iNoBins - 1) + dBinWidth / 2.0R


        Return {dXMin, dXMax, dBinWidth}
    End Function
End Class
End Namespace
