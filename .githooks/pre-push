#!/bin/sh
# Optional, opt-in Git for Windows hook. Run portable tests before push.
# Enable from the repository root: git config core.hooksPath .githooks
powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-beshstatng.ps1
status=$?
if [ "$status" -ne 0 ]; then
  echo "BESHStatNG portable regression tests failed; push blocked." >&2
  exit "$status"
fi
exit 0
