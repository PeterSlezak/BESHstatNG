@page "/"
@using System.Globalization
@using Microsoft.JSInterop
@using BESHStatNG
@using BESHStatNG.AppInfrastructure
@using BESHStatNG.ExcelCommon
@inject IJSRuntime JS

<PageTitle>BESHStat shared Excel layer Stage 3</PageTitle>

<h1>BESHStat shared Excel application layer</h1>

<p>
    Stage 3 moves spreadsheet parsing, analysis orchestration, ResultTable transfer metadata,
    and p-value presentation instructions into a host-neutral .NET Standard layer. Office.js
    is now only the Excel adapter that reads cells and writes the supplied result request.
</p>

<div class="alert @(officeHost?.IsExcel == true ? "alert-success" : "alert-secondary")">
    <strong>Office host:</strong> @officeStatus
</div>

<div class="mb-3">
    <button class="btn btn-outline-secondary me-2" @onclick="RefreshOfficeStatus">
        Check Excel host
    </button>
    <button class="btn btn-outline-primary me-2" @onclick="ReadSelection" disabled="@isBusy">
        Read selected range
    </button>
    <button class="btn btn-primary" @onclick="RunAnovaAndWrite" disabled="@isBusy">
        Run ANOVA and write result
    </button>
</div>

<p><strong>Status:</strong> @status</p>

<div class="card mb-4" style="max-width: 1000px;">
    <div class="card-body">
        <h5 class="card-title">Shared writer options</h5>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Output destination</label>
                <select class="form-select" @bind="outputDestination">
                    <option value="@SpreadsheetOutputDestination.NewWorksheet">New worksheet</option>
                    <option value="@SpreadsheetOutputDestination.CurrentWorksheet">Current worksheet</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Worksheet name</label>
                <input class="form-control" @bind="outputWorksheetName" disabled="@(outputDestination != SpreadsheetOutputDestination.NewWorksheet)" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Start row</label>
                <input class="form-control" type="number" min="1" @bind="outputStartRow" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Start column</label>
                <input class="form-control" type="number" min="1" @bind="outputStartColumn" />
            </div>
        </div>

        <hr />

        <h6>P-value presentation passed to the host writer</h6>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Decimal places</label>
                <input class="form-control" type="number"
                       min="@PValuePresentationSettings.MinimumDecimalPlaces"
                       max="@PValuePresentationSettings.MaximumDecimalPlaces"
                       @bind="pvalueDecimalPlaces" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Very small p-values</label>
                <select class="form-select" @bind="pvalueSmallValueDisplay">
                    <option value="@PValueSmallValueDisplay.LessThanThreshold">&lt; threshold</option>
                    <option value="@PValueSmallValueDisplay.ScientificNotation">Scientific notation</option>
                    <option value="@PValueSmallValueDisplay.FixedDecimal">Fixed decimal</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Alpha</label>
                <input class="form-control" type="number" min="0.0001" max="0.9999" step="0.01" @bind="pvalueHighlightAlpha" />
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" @bind="pvalueUseUpperBound" id="upperBoundCheck" />
                    <label class="form-check-label" for="upperBoundCheck">Show &gt; upper threshold</label>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4" style="max-width: 1000px;">
    <div class="card-body">
        <h5 class="card-title">Expected Excel input</h5>
        <p class="card-text mb-2">
            Select one rectangular range. The first row contains group names; each remaining
            column contains numeric observations for that group. Blank data cells are ignored.
            Input validation is performed in BESHStat.Excel.Common, not in Office.js.
        </p>
        <table class="table table-bordered table-sm mb-0" style="max-width: 420px;">
            <thead>
                <tr><th>Group A</th><th>Group B</th><th>Group C</th></tr>
            </thead>
            <tbody>
                <tr><td>1</td><td>2</td><td>5</td></tr>
                <tr><td>2</td><td>3</td><td>6</td></tr>
                <tr><td>3</td><td>4</td><td>7</td></tr>
            </tbody>
        </table>
    </div>
</div>

@if (selection is not null)
{
    <div class="mb-4">
        <h3>Selected Excel data</h3>
        <p>
            <strong>Worksheet:</strong> @selection.WorksheetName<br />
            <strong>Range:</strong> @selection.Address
        </p>

        @if (groupedPreview is not null)
        {
            <p>
                <strong>Shared parser:</strong>
                @string.Join(", ", groupedPreview.GroupNames.Select((name, index) => $"{name} (n={groupedPreview.Groups[index].Length})"))
            </p>
        }
    </div>
}

@if (output is not null)
{
    <div class="mt-4">
        <h3>BESHStat.Core ANOVA result</h3>
        <p>
            <strong>F:</strong> @output.FStatistic.ToString("G12", CultureInfo.InvariantCulture)<br />
            <strong>p-value:</strong> @output.PValue.ToString("G12", CultureInfo.InvariantCulture)
        </p>

        <table class="table table-bordered table-sm" style="max-width: 950px;">
            <tbody>
                @for (var row = 0; row < output.Table.RowCount; row++)
                {
                    <tr>
                        @for (var col = 0; col < output.Table.ColumnCount; col++)
                        {
                            if (IsHeaderCell(output.Table, row, col))
                            {
                                <th>@FormatCell(output.Table.Values[row, col])</th>
                            }
                            else
                            {
                                <td>@FormatCell(output.Table.Values[row, col])</td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>

        @if (writeResult is not null)
        {
            <p class="alert alert-success" style="max-width: 950px;">
                Excel output written to <strong>@writeResult.WorksheetName</strong>
                at <strong>@writeResult.Address</strong>.<br />
                <small>Shared p-value number format: <code>@writeResult.PvalueNumberFormat</code></small>
            </p>
        }
    </div>
}

@code {
    private OfficeHostStatus? officeHost;
    private SpreadsheetRangeData? selection;
    private GroupedNumericData? groupedPreview;
    private OneWayAnovaApplicationResult? output;
    private OfficeWriteResult? writeResult;

    private string officeStatus = "Checking...";
    private string status = "Select a range in Excel, then run the Stage 3 shared-layer test.";
    private bool isBusy;

    private SpreadsheetOutputDestination outputDestination = SpreadsheetOutputDestination.NewWorksheet;
    private string outputWorksheetName = "BESHStat_WASM_Result";
    private int outputStartRow = 1;
    private int outputStartColumn = 1;

    private int pvalueDecimalPlaces = PValuePresentationSettings.DefaultDecimalPlaces;
    private PValueSmallValueDisplay pvalueSmallValueDisplay = PValueSmallValueDisplay.LessThanThreshold;
    private bool pvalueUseUpperBound = true;
    private double pvalueHighlightAlpha = 0.05;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await RefreshOfficeStatus();
        StateHasChanged();
    }

    private async Task RefreshOfficeStatus()
    {
        try
        {
            officeHost = await JS.InvokeAsync<OfficeHostStatus>("beshOffice.getHostStatus", 2500);
            officeStatus = officeHost.Message;

            if (officeHost.IsExcel)
            {
                var details = new List<string>();
                if (!string.IsNullOrWhiteSpace(officeHost.Host))
                    details.Add(officeHost.Host);
                if (!string.IsNullOrWhiteSpace(officeHost.Platform))
                    details.Add(officeHost.Platform);

                if (details.Count > 0)
                    officeStatus += " " + string.Join(" / ", details) + ".";
            }
        }
        catch (Exception ex)
        {
            officeHost = null;
            officeStatus = "Unable to query Office.js: " + ex.Message;
        }
    }

    private async Task ReadSelection()
    {
        try
        {
            isBusy = true;
            selection = await JS.InvokeAsync<SpreadsheetRangeData>("beshOffice.getSelectedRangeData");
            groupedPreview = GroupedNumericRangeParser.Parse(selection);
            output = null;
            writeResult = null;
            status = $"PASS — host adapter read {selection.Address}; BESHStat.Excel.Common validated the grouped input.";
        }
        catch (Exception ex)
        {
            groupedPreview = null;
            output = null;
            writeResult = null;
            status = "FAIL — " + ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RunAnovaAndWrite()
    {
        try
        {
            isBusy = true;
            writeResult = null;

            selection = await JS.InvokeAsync<SpreadsheetRangeData>("beshOffice.getSelectedRangeData");
            groupedPreview = GroupedNumericRangeParser.Parse(selection);
            output = OneWayAnovaApplicationService.Run(selection);

            var settings = new PValuePresentationSettings
            {
                DecimalPlaces = pvalueDecimalPlaces,
                SmallValueDisplay = pvalueSmallValueDisplay,
                UseUpperBound = pvalueUseUpperBound
            };
            settings.EnsureDefaults();

            var target = new SpreadsheetOutputTarget
            {
                Destination = outputDestination,
                WorksheetName = outputWorksheetName,
                StartRow = outputStartRow,
                StartColumn = outputStartColumn
            };

            var request = ResultTableWriteRequestFactory.Create(
                output.Table,
                settings,
                pvalueHighlightAlpha,
                target);

            writeResult = await JS.InvokeAsync<OfficeWriteResult>("beshOffice.writeResultTable", request);

            status = $"PASS — Excel adapter → shared input parser → shared ANOVA service → BESHStat.Core → " +
                     $"shared ResultTable write request → Office.js writer completed. " +
                     $"F = {output.FStatistic:G12}; p = {output.PValue:G12}.";
        }
        catch (Exception ex)
        {
            output = null;
            writeResult = null;
            status = "FAIL — " + ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private static bool IsHeaderCell(ResultTableOutputModel model, int row, int col)
    {
        var topHeaderEnd = model.TitleRows + model.HeaderTopRows;
        if (row < topHeaderEnd)
            return true;

        return col < model.HeaderLeftColumns &&
               row < model.RowCount - model.FooterRows;
    }

    private static string FormatCell(object? value)
    {
        if (value is null)
            return string.Empty;

        if (value is double d)
            return d.ToString("G12", CultureInfo.InvariantCulture);

        if (value is float f)
            return f.ToString("G9", CultureInfo.InvariantCulture);

        return Convert.ToString(value, CultureInfo.InvariantCulture) ?? string.Empty;
    }

    private sealed class OfficeHostStatus
    {
        public bool OfficeJsLoaded { get; set; }
        public bool IsExcel { get; set; }
        public string Host { get; set; } = string.Empty;
        public string Platform { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
    }

    private sealed class OfficeWriteResult
    {
        public string WorksheetName { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public int[] PvalueColumns { get; set; } = Array.Empty<int>();
        public string PvalueNumberFormat { get; set; } = string.Empty;
    }
}
