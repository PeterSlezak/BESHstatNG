    private async Task RunSharedAnalysisAndWrite()
    {
        if (isBusy || disposed) return;
        using var execution = RegisterExecution();
        var diagnosticStage = "validation";
        string? confirmationToken = null;
        var writeInFlight = false;
        writeResult = null; // Do not let a previous invocation mask an early failure.
        try
        {
            var runKind = analysisKind;
            // Capture all editable run options and source identity before the first await.
            var target = new SpreadsheetOutputTarget { Destination = outputDestination,
                WorksheetName = outputWorksheetName, StartRow = outputStartRow, StartColumn = outputStartColumn };
            var runWorksheet = sourceWorksheetName;
            var runAddress = sourceAddress;
            var configured = useConfiguredParsing;
            var groupedOptions = MakeGroupedOptions();
            var effective = NormalizeLocalPreferences().Snapshot;
            var runWelch = includeWelch;
            var runDunn = includeDunn;
            var trace = preferences.TraceEnabled;
            var operation = runKind == SpreadsheetAnalysisKind.OneWayAnova ? AnalysisIds.OneWayAnova :
                runKind == SpreadsheetAnalysisKind.KruskalWallis ? AnalysisIds.KruskalWallis : "redacted";
            await execution.RunAsync(new DiagnosticEmitter(new BrowserDiagnosticSink(JS)), operation, trace, async session =>
            {
                var run = session.Diagnostics!;
                diagnosticStatus = $"Run {run.RunId} | diagnostic.run.started | invocation. Diagnostics use the browser console only; no reload persistence.";
                session.Checkpoint(ExecutionStage.Validation, 5);
                writeResult = null;
                selection = null;
                selectedAreas = null;
                groupedPreview = null;
                groupedValidationMessage = null;
                groupedIssues = null;

                // Preflight MUST run before reading the selection or running the statistical engine.
                hostCapabilities = await JS.InvokeAsync<HostCapabilitySnapshot>("beshOffice.getHostCapabilities");
                session.Execution.ThrowIfCancellationRequested();
                IAnalysisDescriptor descriptor = null!;
                if (!AnalysisCatalog.TryGetByLegacyKind(runKind, ref descriptor))
                    throw new HostCapabilityException(CapabilityPreflightResult.Rejected(
                        CapabilityPreflightCodes.UnsupportedAnalysis, "Unsupported analysis."));
                var analysisId = descriptor.Id;
                HostCapabilityPreflight.CheckRunAndWrite(analysisId, hostCapabilities, target).EnsureSupported();
                var targetDecision = TargetPlanner.Create(target, hostCapabilities);
                target = targetDecision.ToTarget(); // preserves both one-based inputs; no fallback/default repair
                if (previewLifecycle is not null) await previewLifecycle.DisposeAsync();
                previewLifecycle = null;
                var reference = string.IsNullOrWhiteSpace(runAddress) && string.IsNullOrWhiteSpace(runWorksheet) ? null :
                    SpreadsheetRangeReference.FromUserInput(runWorksheet, runAddress);
                session.Lifecycle = await BeginLifecycleAsync(reference, target);

                diagnosticStage = "acquisition";
                await run.ReportAsync("diagnostic.stage.entered", diagnosticStage);
                selection = await session.AcquireAsync(async () =>
                {
                    if (string.IsNullOrWhiteSpace(runAddress) && string.IsNullOrWhiteSpace(runWorksheet))
                        return await JS.InvokeAsync<SpreadsheetRangeData>("beshOffice.getSelectedRangeData", new { lifecycleHandle = session.Lifecycle.Handle });
                    return await JS.InvokeAsync<SpreadsheetRangeData>("beshOffice.getRangeDataByReference",
                        reference, new { lifecycleHandle = session.Lifecycle.Handle });
              });
                await AcceptLifecycleInputAsync(session.Lifecycle, new[] { selection }, true);
                if (configured)
                {
                    var parsed = GroupedNumericRangeParser.ParseWithDiagnostics(selection, groupedOptions);
                    groupedIssues = parsed.Validation.Issues.ToList();
                    if (!parsed.Success) throw new SpreadsheetInputValidationException(parsed.Validation);
                    groupedPreview = parsed.Data;
                }
                else
                {
                    // Narrow legacy parser boundary only; arbitrary ArgumentExceptions elsewhere
                    // remain unexpected failures. Preserve the original parser semantics.
                    try { groupedPreview = GroupedNumericRangeParser.Parse(selection); }
                    catch (ArgumentException)
                    {
                        throw new SpreadsheetInputValidationException(new SpreadsheetValidationReport(new[] {
                            new SpreadsheetValidationIssue("input.legacy-invalid", SpreadsheetValidationSeverity.Error,
                                "Invalid grouped input.", "input") }));
                    }
                }
                SpreadsheetAnalysisOptions options;
                switch (runKind)
                {
                    case SpreadsheetAnalysisKind.OneWayAnova:
                        var anovaOptions = effective.CreateAnovaOptions();
                        anovaOptions.IncludeWelch = runWelch;
                        options = anovaOptions;
                        break;

                    case SpreadsheetAnalysisKind.KruskalWallis:
                        var kwOptions = effective.CreateKruskalWallisOptions();
                        kwOptions.IncludeDunnComparisons = runDunn;
                        options = kwOptions;
                        break;

                    default:
                        throw new NotSupportedException("Unsupported shared analysis kind.");
                }

                // The Office prototype exercises the stable-ID facade while the Windows
                // Excel-DNA caller retains the original enum-based request facade.
                SpreadsheetAnalysisInput analysisInput = configured ? groupedPreview! : selection;
                diagnosticStage = "analysis";
                session.Checkpoint(ExecutionStage.Analysis, 35);
                await run.ReportAsync("diagnostic.stage.entered", diagnosticStage);
                session.Execution.ThrowIfCancellationRequested();
                sharedOutput = SharedAnalysisApplicationService.Run(analysisId, analysisInput, options);
                session.Checkpoint(ExecutionStage.Output, 80);
                anovaOutput = sharedOutput.Detail as OneWayAnovaApplicationResult;
                kruskalOutput = sharedOutput.Detail as KruskalWallisApplicationResult;

                var settings = effective.CreateDisplaySettings();

                diagnosticStage = "output";
                var document = OutputDocument.FromResult(sharedOutput);
                var semantics = OutputSemanticPlanner.Create(document, settings, effective.DefaultAlpha);
                var layout = OutputLayoutPlanner.Create(document, target,
                    new OutputLayoutOptions(blankRowsBetweenTables: 1), semanticPlan: semantics);
                var preparedPlan = OfficeOutputPlanAdapter.Prepare(document, semantics, layout);

                if (preparedPlan.TableCount == 0)
                    throw new InvalidOperationException("The shared analysis returned no result tables.");

                await run.ReportAsync("diagnostic.output.attempted", diagnosticStage);
                writeResult = await session.WriteAsync(() => {
                    writeInFlight = true;
                    return JS.InvokeAsync<OfficeWriteResult>("beshOffice.writeOutputPlan", preparedPlan, null, session.Lifecycle.Handle).AsTask();
                });
                writeInFlight = false;
                if (writeResult.State == "AwaitingConfirmation" && writeResult.Confirmation is not null)
                {
                    confirmationToken = writeResult.Confirmation.Token;
                    status = "Output is occupied. Choose Overwrite or Cancel below.";
                    var overwriteChoice = session.BeginConfirmation(() => { if (!disposed) _ = RefreshSafelyAsync(); });
                    var approved = await overwriteChoice.Task;
                    var token = writeResult.Confirmation.Token;
                    writeResult = await session.WriteAsync(() => {
                        writeInFlight = true;
                        return JS.InvokeAsync<OfficeWriteResult>("beshOffice.writeOutputPlan", preparedPlan,
                            new { token, approved }, session.Lifecycle.Handle).AsTask();
                    });
                    writeInFlight = false;
                }
                status = writeResult.State == "Completed" ? BuildSuccessStatus() :
                    UserFaultMapper.FormatDisplay(OfficeFaultPresentation.WriteFault(writeResult.State, writeResult.Code,
                        writeResult.MutationMayHaveOccurred), run.RunId);
                var outputCode = writeResult.State == "Completed" ? "diagnostic.output.completed" : "diagnostic.output.incomplete";
                await run.ReportAsync(outputCode, diagnosticStage, new Dictionary<string, string> {
                    ["outcome"] = writeResult.State == "Completed" ? "completed" : writeResult.State == "CancelledByUser" ? "cancelled" : "incomplete" });
                diagnosticStatus = $"Run {run.RunId} | {outputCode} | {diagnosticStage}. Console diagnostics only; delivery is best effort.";
                session.FinishOutput(writeResult.State);
            });
        }
        catch (OperationCanceledException ex) when (ex.CancellationToken == execution.Execution.Token && execution.Execution.Snapshot.IsCancellationRequested)
        {
            status = UserFaultMapper.FormatDisplay(writeResult?.State == "CancelledByUser"
                ? OfficeFaultPresentation.WriteFault(writeResult.State, writeResult.Code, writeResult.MutationMayHaveOccurred)
                : UserFaultMapper.FromOutcome(execution.Execution.Snapshot), execution.Diagnostics?.RunId);
            diagnosticStatus = $"Run {execution.Diagnostics?.RunId} | Cancelled | {diagnosticStage}. Diagnostic end is emitted in finally.";
        }
        catch (Exception ex)
        {
            var run = execution.Diagnostics;
            execution.Execution.TryFail(ex);
            var code = diagnosticStage != "output" && ex is SpreadsheetInputValidationException
                ? "diagnostic.validation.rejected" : "diagnostic.run.failed";
            if (run is not null) await run.ReportAsync(code, diagnosticStage, new Dictionary<string, string> {
                ["category"] = code == "diagnostic.validation.rejected" ? "input" : "unexpected" });
            var safeMessage = UserFaultMapper.FormatDisplay(
                writeResult is not null && writeResult.State != "AwaitingConfirmation" && !writeInFlight
                    ? OfficeFaultPresentation.WriteFault(writeResult.State, writeResult.Code, writeResult.MutationMayHaveOccurred)
                    : OfficeFaultPresentation.Failure(execution, ex, writeInFlight), run?.RunId);
            if (selection is not null && groupedPreview is null)
                groupedValidationMessage = safeMessage;
            sharedOutput = null;
            anovaOutput = null;
            kruskalOutput = null;
            // Retain any real writer outcome, including completion. Display cannot relabel it.
            status = writeResult?.State == "Completed" && !writeInFlight ? BuildSuccessStatus() : safeMessage;
            diagnosticStatus = $"Run {run?.RunId} | {code} | {diagnosticStage}. Console diagnostics only; delivery is best effort.";
        }
        finally
        {
            if (confirmationToken is not null)
            {
                try { await JS.InvokeVoidAsync("beshOffice.discardOutputConfirmation", confirmationToken, execution.Lifecycle?.Handle); }
                catch { /* Best effort cleanup only; never approve or write on disposal. */ }
            }
            activeExecution = null;
            isBusy = false;
        }
    }

    private string BuildSuccessStatus()
    {
        if (anovaOutput is not null)
        {
            var welchStatus = anovaOutput.HasWelch
                ? $" Welch F = {anovaOutput.WelchFStatistic:G12}; Welch p = {anovaOutput.WelchPValue:G12}."
                : string.Empty;

            return $"PASS — generic shared dispatcher ran one-way ANOVA and the Office.js batch writer returned all shared tables. " +
                   $"F = {anovaOutput.FStatistic:G12}; p = {anovaOutput.PValue:G12}." + welchStatus;
        }

        if (kruskalOutput is not null)
        {
            return $"PASS — generic shared dispatcher ran Kruskal-Wallis and the Office.js batch writer returned all shared tables. " +
                   $"H = {kruskalOutput.HStatistic:G12}; tie-corrected H = {kruskalOutput.TieCorrectedHStatistic:G12}; " +
                   $"tie-corrected p = {kruskalOutput.TieCorrectedPValue:G12}.";
        }

        return "PASS — shared analysis completed and result tables were written to Excel.";
    }

    private sealed record SourceCellPreview(string Address, string Kind, string Value,
                                             string NumberFormat, bool IsInvalidGroupedObservation);

    private static List<SourceCellPreview> PreviewSourceCells(SpreadsheetRangeData source, int maximum)
    {
        var cells = new List<SourceCellPreview>();
        if (source.Rows is null) return cells;
        for (var row = 0; row < source.Rows.Count && cells.Count < maximum; row++)
        {
            var values = source.Rows[row];
            if (values is null) continue;
            for (var column = 0; column < values.Count && cells.Count < maximum; column++)
            {
                var cell = values[column];
                var kind = cell is null ? "Null" : $"{cell.Kind} ({(int)cell.Kind})";
                var value = cell is null ? "<null>" : cell.Kind switch
                {
                    SpreadsheetCellKind.Blank => "<blank>",
                    SpreadsheetCellKind.Number => cell.NumberValue.ToString("G17", CultureInfo.InvariantCulture),
                    SpreadsheetCellKind.Bool => cell.BooleanValue ? "TRUE" : "FALSE",
                    SpreadsheetCellKind.Text => cell.TextValue?.Length > 0 ? cell.TextValue : "<empty text>",
                    SpreadsheetCellKind.CellError => cell.TextValue ?? "<error>",
                    _ => "<unknown>"
                };
                var rowNumber = source.StartRow > 0 ? source.StartRow + row : row + 1;
                var columnNumber = source.StartColumn > 0 ? source.StartColumn + column : column + 1;
                cells.Add(new SourceCellPreview(
                    ExcelColumnLabel(columnNumber) + rowNumber.ToString(CultureInfo.InvariantCulture),
                    kind, value, cell?.NumberFormat ?? string.Empty,
                    row > 0 && (cell is null || (cell.Kind != SpreadsheetCellKind.Blank &&
                                                 cell.Kind != SpreadsheetCellKind.Number))));
            }
        }
        return cells;
    }

    private static string ExcelColumnLabel(int column)
    {
        var label = string.Empty;
        while (column > 0)
        {
            column--;
            label = (char)('A' + column % 26) + label;
            column /= 26;
        }
        return label;
    }

    private static string AnalysisDisplayName(SpreadsheetAnalysisKind kind)
    {
        foreach (var descriptor in AnalysisCatalog.All)
        {
            if (descriptor.LegacyKind == kind)
                return descriptor.DisplayName;
        }

        return kind.ToString();
    }

    private static bool IsHeaderCell(ResultTableOutputModel model, int row, int col)
    {
        var topHeaderEnd = model.TitleRows + model.HeaderTopRows;
        if (row < topHeaderEnd)
            return true;

        return col < model.HeaderLeftColumns &&
               row < model.RowCount - model.FooterRows;
    }

    private static string FormatCell(object? value)
    {
        if (value is null)
            return string.Empty;

        if (value is double d)
            return d.ToString("G12", CultureInfo.InvariantCulture);

        if (value is float f)
            return f.ToString("G9", CultureInfo.InvariantCulture);

        return Convert.ToString(value, CultureInfo.InvariantCulture) ?? string.Empty;
    }

