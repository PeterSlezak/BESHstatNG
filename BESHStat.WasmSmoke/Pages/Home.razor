    private async Task RefreshOfficeStatus()
    {
        try
        {
            officeHost = await JS.InvokeAsync<OfficeHostStatus>("beshOffice.getHostStatus", 2500);
            hostCapabilities = await JS.InvokeAsync<HostCapabilitySnapshot>("beshOffice.getHostCapabilities");
            officeStatus = officeHost.Message;

            if (officeHost.IsExcel)
            {
                var details = new List<string>();
                if (!string.IsNullOrWhiteSpace(officeHost.Host))
                    details.Add(officeHost.Host);
                if (!string.IsNullOrWhiteSpace(officeHost.Platform))
                    details.Add(officeHost.Platform);

                if (details.Count > 0)
                    officeStatus += " " + string.Join(" / ", details) + ".";
            }
        }
        catch (Exception ex)
        {
            officeHost = null;
            hostCapabilities = null;
            officeStatus = ReadErrorMessage(ex);
        }
    }

    private async Task ReadSelection()
    {
        if (isBusy || disposed) return;
        try
        {
            isBusy = true;
            selection = null;
            selectedAreas = null;
            groupedPreview = null;
            groupedValidationMessage = null;
            groupedIssues = null;
            sharedOutput = null;
            anovaOutput = null;
            kruskalOutput = null;
            writeResult = null;

            hostCapabilities = await JS.InvokeAsync<HostCapabilitySnapshot>("beshOffice.getHostCapabilities");
            HostCapabilityPreflight.CheckSelection(hostCapabilities).EnsureSupported();
            if (previewLifecycle is not null) await previewLifecycle.DisposeAsync();
            previewLifecycle = await BeginLifecycleAsync(SourceReference());
            var acquired = await AcquireRangeAsync(previewLifecycle.Handle);
            await AcceptLifecycleInputAsync(previewLifecycle, new[] { acquired }, false);
            selection = acquired;

            // A successful read must remain inspectable even when a grouped analysis
            // correctly rejects error, text, or Boolean observations.
            try
            {
                groupedPreview = ParseSelectedInput(selection);
                status = $"PASS — acquired typed cells from {selection.Address}; grouped analysis input is valid.";
            }
            catch (ArgumentException ex)
            {
                groupedValidationMessage = UserFaultMapper.FormatDisplay(UserFaultMapper.FromException(ex));
                status = $"PASS — acquired typed cells from {selection.Address}; grouped-analysis validation failed (see preview).";
            }
        }
        catch (Exception ex)
        {
            selection = null;
            groupedPreview = null;
            groupedValidationMessage = null;
            groupedIssues = null;
            if (previewLifecycle is not null) await previewLifecycle.DisposeAsync();
            previewLifecycle = null;
            status = "FAIL — unable to read the source range: " + ReadErrorMessage(ex);
        }
        finally
        {
            isBusy = false;
        }
    }

