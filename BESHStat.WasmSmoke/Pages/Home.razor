@page "/"
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.JSInterop
@using BESHStatNG
@using BESHStatNG.AppInfrastructure
@using BESHStatNG.ExcelCommon
@using BESHStat.WasmSmoke.Infrastructure
@inject IJSRuntime JS

<PageTitle>BESHStat shared Excel layer Stage 3.04</PageTitle>

<h1>BESHStat shared Excel application layer</h1>

<p><a href="@SelectedAnalysisHelp.GetLaunchTarget(PilotProductVersion).Url" target="_blank" rel="noopener noreferrer">Help for selected analysis</a></p>

<p>
    Stage 3.04 proves that the generic shared-analysis boundary supports more than one
    analysis family. One-way ANOVA and Kruskal-Wallis now use the same host-neutral
    request/result contracts from both Office.js and the Windows Excel-DNA host.
</p>

<div class="alert @(officeHost?.IsExcel == true ? "alert-success" : "alert-secondary")">
    <strong>Office host:</strong> @officeStatus
    @if (hostCapabilities is not null)
    {
        <div><small>Available operations: @string.Join(", ", hostCapabilities.Capabilities ?? new List<string>())</small></div>
    }
</div>

<details class="mb-3">
    <summary>Developer demo: composite output (02.07)</summary>
    <p>Synthetic fixture only. Creates a new empty worksheet at C10 with tables, a warning,
        a chart placeholder, an additional note and an inactive HTTPS link. Fixed block dimensions;
        long text may clip visually but remains stored in full. This does not run an analysis.</p>
    <button class="btn btn-outline-secondary" @onclick="WriteCompositeDemo" disabled="@(isBusy || !CanRunSelectedDestination)">Write synthetic composite to new worksheet</button>
    @if (compositeTrace is not null)
    {
        <pre>@compositeTrace</pre>
    }
</details>

<div class="mb-3">
    <button class="btn btn-outline-danger me-2" @onclick="CancelCurrentExecution" disabled="@(activeExecution?.CanCancel != true)">Cancel current execution</button>
    <button class="btn btn-outline-secondary me-2" @onclick="RefreshOfficeStatus">
        Check Excel host
    </button>
    <button class="btn btn-outline-primary me-2" @onclick="ReadSelection" disabled="@(isBusy || !CanReadSelection)">
        Read source range
    </button>
    <button class="btn btn-outline-primary me-2" @onclick="ReadSelectedAreas" disabled="@(isBusy || !CanReadSelection)">
        Read selected areas (01.09)
    </button>
    <button class="btn btn-primary" @onclick="RunSharedAnalysisAndWrite" disabled="@(isBusy || !CanRunSelectedDestination)">
        Run shared analysis and write result
    </button>
</div>

<details class="mb-3">
    <summary>Developer demo: cooperative cancellation (03.03)</summary>
    <p>Bounded synthetic fixture with asynchronous yields, about five seconds. No worksheet data or output.
        Blocking statistical calls and Office.js writes cannot be interrupted by this action.</p>
    <button class="btn btn-outline-secondary" @onclick="RunExecutionDemo" disabled="@isBusy">Start safe yielding fixture</button>
</details>
@if (executionSnapshot is not null)
{
    <p role="status">Execution: @executionSnapshot.State | @executionSnapshot.Stage |
        @(executionSnapshot.Percent.HasValue ? $"{executionSnapshot.Percent}%" : "progress unknown")</p>
}

@if (activeExecution?.AwaitingConsent == true && writeResult?.Confirmation is { } confirmation)
{
    <div class="alert alert-warning" role="alertdialog" aria-label="Overwrite occupied output">
        <strong>Overwrite output on @confirmation.WorksheetName?</strong>
        <p>@confirmation.OccupiedRegionCount occupied output region(s). @confirmation.Message</p>
        <ul>
            @foreach (var rectangle in confirmation.Rectangles)
            {
                <li>@rectangle</li>
            }
        </ul>
        <button class="btn btn-danger me-2" @onclick="() => ChooseOverwrite(true)">Overwrite</button>
        <button class="btn btn-secondary" @onclick="() => ChooseOverwrite(false)">Cancel</button>
    </div>
}

<div class="card mb-3" style="max-width: 1000px;">
    <div class="card-body">
        <h5 class="card-title">Source range (optional)</h5>
        <p class="small text-muted">Leave both fields empty to use the selected Excel range. Otherwise enter a worksheet name (for example <code>Hárok1</code>) and an A1 address (<code>A1:C4</code>), or leave the worksheet name empty and enter <code>'Hárok1'!A1:C4</code> in the address field. A qualified reference pasted into the worksheet field is also accepted when the two fields agree.</p>
        <div class="row g-2">
            <div class="col-md-5">
                <label class="form-label">Worksheet name</label>
                <input class="form-control" @bind="sourceWorksheetName" placeholder="Study Data" />
            </div>
            <div class="col-md-5">
                <label class="form-label">A1 address</label>
                <input class="form-control" @bind="sourceAddress" placeholder="B2:D12" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3" style="max-width: 1000px;">
    <div class="card-body">
        <div class="form-check">
            <input id="configurableParsing" class="form-check-input" type="checkbox" @bind="useConfiguredParsing" />
            <label class="form-check-label" for="configurableParsing">Use configurable grouped-input interpretation (Phase 01.03 preview)</label>
        </div>
        @if (useConfiguredParsing)
        {
            <p class="small text-muted mt-2">Opt-in test of the shared validation and orientation policies. The default unchecked path still uses the original Stage 3.04 parser.</p>
            <div class="row g-2 mt-1">
                <div class="col-md-4">
                    <label class="form-label">Group arrangement</label>
                    <select class="form-select" @bind="groupOrientation">
                        <option value="@SpreadsheetGroupedOrientation.GroupsInColumns">Groups in columns</option>
                        <option value="@SpreadsheetGroupedOrientation.GroupsInRows">Groups in rows</option>
                        <option value="@SpreadsheetGroupedOrientation.LongFormat">Long (category + value)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Header policy</label>
                    <select class="form-select" @bind="groupHeaderMode">
                        <option value="@SpreadsheetHeaderMode.Required">Header required</option>
                        <option value="@SpreadsheetHeaderMode.None">No header</option>
                        <option value="@SpreadsheetHeaderMode.Auto">Auto (reject ambiguous)</option>
                    </select>
                </div>
                @if (groupOrientation == SpreadsheetGroupedOrientation.LongFormat)
                {
                    <div class="col-md-2">
                        <label class="form-label">Category column (1-based)</label>
                        <input class="form-control" type="number" min="1" @bind="categoryColumn" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Value column (1-based)</label>
                        <input class="form-control" type="number" min="1" @bind="valueColumn" />
                    </div>
                }
            </div>
        }
    </div>
</div>

<p><strong>Status:</strong> @status</p>
@if (diagnosticStatus is not null)
{
    <p class="small" role="status"><strong>Run diagnostics:</strong> @diagnosticStatus</p>
}

@if (selectedAreas is not null)
{
    <div class="card mb-3" style="max-width: 1000px;">
        <div class="card-body">
            <h5 class="card-title">Selected areas preview (01.09)</h5>
            <p><strong>Ranges:</strong> @selectedAreas.Ranges.Count</p>
            <p class="small text-muted">Current Excel selection in the order reported by the host. Areas are previewed separately; this read does not run an analysis. The optional source fields apply only to the single-range operations.</p>
            @for (var rangeIndex = 0; rangeIndex < selectedAreas.Ranges.Count; rangeIndex++)
            {
                var area = selectedAreas.Ranges[rangeIndex];
                <h6>Range @(rangeIndex + 1): @area.WorksheetName — @area.Address</h6>
                <p class="small">@area.RowCount rows × @area.ColumnCount columns; top-left row @area.StartRow, column @area.StartColumn.</p>
                <div class="table-responsive mb-3" style="max-height: 280px; overflow-y: auto;">
                    <table class="table table-sm table-bordered mb-0">
                        <thead><tr><th>Cell</th><th>Kind</th><th>Underlying value</th><th>Number format</th></tr></thead>
                        <tbody>
                            @foreach (var sourceCell in PreviewSourceCells(area, int.MaxValue))
                            {
                                <tr>
                                    <td><code>@sourceCell.Address</code></td>
                                    <td>@sourceCell.Kind</td>
                                    <td>@sourceCell.Value</td>
                                    <td><code>@sourceCell.NumberFormat</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (selection is not null)
{
    var sourceCells = PreviewSourceCells(selection, 60);
    <div class="card mb-3" style="max-width: 1000px;">
        <div class="card-body">
            <h5 class="card-title">Raw Excel cell kinds (before analysis parsing)</h5>
            <p class="small mb-2">
                <strong>Source:</strong> @selection.QualifiedAddress
                (@selection.RowCount rows × @selection.ColumnCount columns).
                <strong>Date system:</strong> @selection.DateSystem.
            </p>
            <p class="small text-muted mb-2">
                This is the typed snapshot returned by Office.js, not a result of numeric coercion.
                A date-formatted number remains <code>Number (1)</code>; an Excel error is
                <code>CellError (4)</code>, while literal error-looking text is <code>Text (2)</code>.
            </p>
            @if (groupedIssues is not null && groupedIssues.Count > 0)
            {
                <div class="mb-2">
                    <strong class="small">Structured grouped-input diagnostics:</strong>
                    <ul class="small mb-0">
                        @foreach (var issue in groupedIssues.Take(12))
                        {
                            var safeIssue = UserFaultMapper.FromValidation(issue);
                            <li><code>@safeIssue.Code</code> (@safeIssue.Severity): @safeIssue.Action
                                @if (safeIssue.OriginalCode is not null)
                                {
                                    <span> (<code>@safeIssue.OriginalCode</code>)</span>
                                }
                                @if (safeIssue.SelectedRow > 0)
                                {
                                    <span> — selected row @safeIssue.SelectedRow, column @safeIssue.SelectedColumn</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(groupedValidationMessage))
            {
                <div class="alert alert-warning py-2 mb-2">
                    <strong>Grouped-analysis validation:</strong> @groupedValidationMessage
                    <div class="small mt-1">The source read succeeded. This range is not valid ANOVA/Kruskal–Wallis input; the raw cell kinds below are still available for inspection.</div>
                </div>
            }
            <div class="table-responsive" style="max-height: 280px; overflow-y: auto;">
                <table class="table table-sm table-bordered mb-0">
                    <thead><tr><th>Cell</th><th>Kind</th><th>Underlying value</th><th>Number format</th></tr></thead>
                    <tbody>
                        @foreach (var sourceCell in sourceCells)
                        {
                            <tr class="@(sourceCell.IsInvalidGroupedObservation ? "table-warning" : "")">
                                <td><code>@sourceCell.Address</code></td>
                                <td>@sourceCell.Kind</td>
                                <td>@sourceCell.Value</td>
                                <td><code>@sourceCell.NumberFormat</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if ((long)selection.RowCount * selection.ColumnCount > sourceCells.Count)
            {
                <p class="small text-muted mt-2 mb-0">Preview limited to the first @sourceCells.Count cells. Select a smaller range to inspect later cells.</p>
            }
            <p class="small text-muted mt-2 mb-0">Highlighted rows contain a nonnumeric/nonblank observation after the first header row and are not accepted by the legacy grouped parser.</p>
        </div>
    </div>
}

<div class="card mb-4" style="max-width: 1000px;">
    <div class="card-body">
        <h5 class="card-title">Shared analysis options</h5>
        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label">Analysis</label>
                <select class="form-select" @bind="analysisKind">
                    @foreach (var descriptor in AnalysisCatalog.All)
                    {
                        if (descriptor.LegacyKind.HasValue)
                        {
                            <option value="@descriptor.LegacyKind.Value">@descriptor.DisplayName</option>
                        }
                    }
                </select>
            </div>
        </div>

        @if (analysisKind == SpreadsheetAnalysisKind.OneWayAnova)
        {
            <div class="form-check mt-3">
                <input class="form-check-input" type="checkbox" @bind="includeWelch" id="welchCheck" />
                <label class="form-check-label" for="welchCheck">
                    Include Welch ANOVA columns in the primary result table
                </label>
            </div>
        }
        else if (analysisKind == SpreadsheetAnalysisKind.KruskalWallis)
        {
            <div class="form-check mt-3">
                <input class="form-check-input" type="checkbox" @bind="includeDunn" id="dunnCheck" />
                <label class="form-check-label" for="dunnCheck">
                    Include Dunn's Bonferroni-adjusted pairwise comparisons
                </label>
            </div>
        }

        <hr />

        <h5 class="card-title">Shared writer options</h5>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Output destination</label>
                <select class="form-select" @bind="outputDestination">
                    <option value="@SpreadsheetOutputDestination.NewWorksheet" disabled="@(!SupportsDestination(SpreadsheetOutputDestination.NewWorksheet))">New worksheet</option>
                    <option value="@SpreadsheetOutputDestination.CurrentWorksheet" disabled="@(!SupportsDestination(SpreadsheetOutputDestination.CurrentWorksheet))">Current worksheet</option>
                    <option value="@SpreadsheetOutputDestination.NewWorkbook" disabled="@(!SupportsDestination(SpreadsheetOutputDestination.NewWorkbook))">New workbook (unavailable in Office.js)</option>
                </select>
                @if (!SupportsDestination(outputDestination))
                {
                    <small class="text-danger">This destination is unavailable in the current host. Select a supported worksheet destination explicitly.</small>
                }
            </div>

            <div class="col-md-4">
                <label class="form-label">Worksheet name</label>
                <input class="form-control" @bind="outputWorksheetName" disabled="@(outputDestination != SpreadsheetOutputDestination.NewWorksheet)" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Start row</label>
                <input class="form-control" type="number" min="1" @bind="outputStartRow" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Start column</label>
                <input class="form-control" type="number" min="1" @bind="outputStartColumn" />
            </div>
        </div>

        <hr />

        <h6>P-value presentation passed to the host writer</h6>
        <p class="small">These fields apply to this analysis. Save/apply preferences intentionally makes them
            defaults for this task-pane URL. Unsaved changes do not alter stored preferences.</p>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Decimal places</label>
                <input class="form-control" type="number"
                       min="@PValuePresentationSettings.MinimumDecimalPlaces"
                       max="@PValuePresentationSettings.MaximumDecimalPlaces"
                       @bind="pvalueDecimalPlaces" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Very small p-values</label>
                <select class="form-select" @bind="pvalueSmallValueDisplay">
                    <option value="@PValueSmallValueDisplay.LessThanThreshold">&lt; threshold</option>
                    <option value="@PValueSmallValueDisplay.ScientificNotation">Scientific notation</option>
                    <option value="@PValueSmallValueDisplay.FixedDecimal">Fixed decimal</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Alpha</label>
                <input class="form-control" type="number" min="0.0001" max="0.9999" step="0.01" @bind="pvalueHighlightAlpha" />
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" @bind="pvalueUseUpperBound" id="upperBoundCheck" />
                    <label class="form-check-label" for="upperBoundCheck">Show &gt; upper threshold</label>
                </div>
            </div>
        </div>
        <button class="btn btn-outline-secondary mt-3" @onclick="SavePreferences" disabled="@(isBusy || !preferencesLoaded)">Save/apply preferences</button>
        <p class="small mt-2" role="status">@preferenceStatus</p>
    </div>
</div>

<div class="card mb-4" style="max-width: 1000px;">
    <div class="card-body">
        <h5 class="card-title">Expected Excel input</h5>
        <p class="card-text mb-2">
            Select one rectangular range, or specify its worksheet and A1 address above. The first row contains group names; each remaining
            column contains numeric observations for that group. Blank data cells are ignored.
            The original grouped-data parser is the default for both families. Enable the optional Phase 01.03 preview above to test other orientations and header policies.
        </p>

        @if (analysisKind == SpreadsheetAnalysisKind.OneWayAnova)
        {
            <table class="table table-bordered table-sm mb-0" style="max-width: 420px;">
                <thead><tr><th>Group A</th><th>Group B</th><th>Group C</th></tr></thead>
                <tbody>
                    <tr><td>1</td><td>2</td><td>5</td></tr>
                    <tr><td>2</td><td>3</td><td>6</td></tr>
                    <tr><td>3</td><td>4</td><td>7</td></tr>
                </tbody>
            </table>
        }
        else
        {
            <table class="table table-bordered table-sm mb-0" style="max-width: 420px;">
                <thead><tr><th>A</th><th>B</th><th>C</th></tr></thead>
                <tbody>
                    <tr><td>1</td><td>2</td><td>4</td></tr>
                    <tr><td>2</td><td>3</td><td>5</td></tr>
                    <tr><td>2</td><td>4</td><td>5</td></tr>
                    <tr><td>3</td><td>4</td><td>6</td></tr>
                </tbody>
            </table>
        }
    </div>
</div>

@if (selection is not null)
{
    <div class="mb-4">
        <h3>Selected Excel data</h3>
        <p>
            <strong>Worksheet:</strong> @selection.WorksheetName<br />
            <strong>Range:</strong> @selection.QualifiedAddress<br />
            <strong>Worksheet identity:</strong> @selection.WorksheetId<br />
            <strong>Top-left cell:</strong> row @selection.StartRow, column @selection.StartColumn
        </p>

        @if (groupedPreview is not null)
        {
            <p>
                <strong>Shared parser:</strong>
                @string.Join(", ", groupedPreview.GroupNames.Select((name, index) => $"{name} (n={groupedPreview.Groups[index].Length})"))
            </p>
        }
    </div>
}

@if (sharedOutput is not null)
{
    <div class="mt-4">
        <h3>BESHStat.Core @AnalysisDisplayName(sharedOutput.AnalysisKind) result</h3>

        @if (anovaOutput is not null)
        {
            <p>
                <strong>F:</strong> @anovaOutput.FStatistic.ToString("G12", CultureInfo.InvariantCulture)<br />
                <strong>p-value:</strong> @anovaOutput.PValue.ToString("G12", CultureInfo.InvariantCulture)
            </p>

            @if (anovaOutput.HasWelch)
            {
                <p>
                    <strong>Welch F:</strong> @anovaOutput.WelchFStatistic.ToString("G12", CultureInfo.InvariantCulture)<br />
                    <strong>Welch denominator df:</strong> @anovaOutput.WelchDenominatorDf.ToString("G12", CultureInfo.InvariantCulture)<br />
                    <strong>Welch p-value:</strong> @anovaOutput.WelchPValue.ToString("G12", CultureInfo.InvariantCulture)
                </p>
            }
        }
        else if (kruskalOutput is not null)
        {
            <p>
                <strong>H:</strong> @kruskalOutput.HStatistic.ToString("G12", CultureInfo.InvariantCulture)<br />
                <strong>p-value:</strong> @kruskalOutput.PValue.ToString("G12", CultureInfo.InvariantCulture)<br />
                <strong>Tie-corrected H:</strong> @kruskalOutput.TieCorrectedHStatistic.ToString("G12", CultureInfo.InvariantCulture)<br />
                <strong>Tie-corrected p-value:</strong> @kruskalOutput.TieCorrectedPValue.ToString("G12", CultureInfo.InvariantCulture)
            </p>
        }

        @for (var tableIndex = 0; tableIndex < sharedOutput.Tables.Count; tableIndex++)
        {
            var table = sharedOutput.Tables[tableIndex];
            if (sharedOutput.Tables.Count > 1)
            {
                <h5 class="mt-4">Result table @(tableIndex + 1)</h5>
            }

            <table class="table table-bordered table-sm" style="max-width: 950px;">
                <tbody>
                    @for (var row = 0; row < table.RowCount; row++)
                    {
                        <tr>
                            @for (var col = 0; col < table.ColumnCount; col++)
                            {
                                if (IsHeaderCell(table, row, col))
                                {
                                    <th>@FormatCell(table.Values[row, col])</th>
                                }
                                else
                                {
                                    <td>@FormatCell(table.Values[row, col])</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (writeResult?.State == "Completed")
        {
            <p class="alert alert-success" style="max-width: 950px;">
                Excel output written to <strong>@writeResult.WorksheetName</strong>
                at <strong>@writeResult.Address</strong>.<br />
                <small>@writeResult.TableAddresses.Length table(s) written through the generic Office.js batch writer.</small><br />
                <small>Shared p-value number format: <code>@writeResult.PvalueNumberFormat</code></small>
            </p>
        }
        else if (writeResult is not null && writeResult.State != "AwaitingConfirmation")
        {
            <p class="alert @(writeResult.State == "CancelledByUser" ? "alert-secondary" : "alert-warning")" style="max-width: 950px;">
                @UserFaultMapper.FormatDisplay(OfficeFaultPresentation.WriteFault(writeResult.State, writeResult.Code,
                    writeResult.MutationMayHaveOccurred), activeExecution?.Diagnostics?.RunId)
            </p>
        }
    </div>
}

@code {
    private string? diagnosticStatus;
    private OfficeExecutionRun? activeExecution;
    private ExecutionSnapshot? executionSnapshot;
    private bool disposed;
    private OfficeDocumentLifecycle? previewLifecycle;
    private DotNetObjectReference<Home>? lifecycleObserver;
    private void ChooseOverwrite(bool approved) => activeExecution?.ChooseOverwrite(approved);
    private void CancelCurrentExecution() => activeExecution?.Cancel();
    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        activeExecution?.Dispose();
        if (activeExecution?.Lifecycle is { } running) await running.DisposeAsync();
        if (previewLifecycle is { } preview) await preview.DisposeAsync();
        lifecycleObserver?.Dispose();
        lifecycleObserver = null;
    }
    private async Task RefreshSafelyAsync()
    {
        if (disposed) return;
        try { await InvokeAsync(() => { if (!disposed) StateHasChanged(); }); }
        catch (InvalidOperationException) when (disposed) { }
    }
    [JSInvokable]
    public async Task DocumentLifecycleChanged(string handle)
    {
        if (disposed) return;
        var previewChanged = previewLifecycle?.NotifyInvalidated(handle) == true;
        var runChanged = activeExecution?.NotifyLifecycleChanged(handle) == true;
        if (previewChanged)
        {
            selection = null;
            selectedAreas = null;
            groupedPreview = null;
        }
        if (previewChanged || runChanged)
        {
            status = UserFaultMapper.FormatDisplay(UserFaultMapper.FromException(
                new DocumentLifecycleException(DocumentInvalidationReason.DocumentChanged)), activeExecution?.Diagnostics?.RunId);
            await RefreshSafelyAsync();
        }
    }
    private SpreadsheetRangeReference? SourceReference() =>
        string.IsNullOrWhiteSpace(sourceAddress) && string.IsNullOrWhiteSpace(sourceWorksheetName) ? null :
            SpreadsheetRangeReference.FromUserInput(sourceWorksheetName, sourceAddress);

    private async Task<OfficeDocumentLifecycle> BeginLifecycleAsync(SpreadsheetRangeReference? reference,
        SpreadsheetOutputTarget? target = null, bool areas = false)
    {
        if (disposed) throw new DocumentLifecycleException(DocumentInvalidationReason.ContextDisposed);
        lifecycleObserver ??= DotNetObjectReference.Create(this);
        OfficeLifecycleBinding binding;
        try
        {
            binding = await JS.InvokeAsync<OfficeLifecycleBinding>("beshOffice.beginDocumentLifecycle",
                new { sourceReference = reference, target, selectedAreas = areas }, lifecycleObserver);
        }
        catch (JSException) { throw new DocumentLifecycleException(DocumentInvalidationReason.Unverifiable); }
        OfficeDocumentLifecycle lifecycle;
        try
        {
            lifecycle = new OfficeDocumentLifecycle(binding,
                handle => JS.InvokeVoidAsync("beshOffice.disposeDocumentLifecycle", handle).AsTask());
        }
        catch
        {
            try { await JS.InvokeVoidAsync("beshOffice.disposeDocumentLifecycle", binding.Handle); } catch { }
            throw new DocumentLifecycleException(DocumentInvalidationReason.Unverifiable);
        }
        if (disposed)
        {
            await lifecycle.DisposeAsync();
            throw new DocumentLifecycleException(DocumentInvalidationReason.ContextDisposed);
        }
        return lifecycle;
    }
    private async Task AcceptLifecycleInputAsync(OfficeDocumentLifecycle lifecycle, IEnumerable<SpreadsheetRangeData> ranges, bool copied)
    {
        // Send bounded identity/coordinate metadata only, never the copied worksheet values.
        try
        {
            await JS.InvokeVoidAsync("beshOffice.acceptLifecycleInput", lifecycle.Handle, new {
                ranges = ranges.Select(range => new { range.WorksheetId, range.WorksheetName, range.StartRow,
                    range.StartColumn, range.RowCount, range.ColumnCount }).ToArray()
            }, copied);
        }
        catch (JSException) { throw new DocumentLifecycleException(DocumentInvalidationReason.Unverifiable); }
        lifecycle.EnsureCurrent();
    }
    private OfficeExecutionRun RegisterExecution()
    {
        isBusy = true;
        var execution = new OfficeExecutionRun();
        activeExecution = execution;
