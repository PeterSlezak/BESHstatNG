@page "/"
@using System.Globalization
@using Microsoft.JSInterop
@using BESHStatNG
@using BESHStatNG.AppInfrastructure
@using BESHStatNG.ExcelCommon
@inject IJSRuntime JS

<PageTitle>BESHStat shared Excel layer Stage 3.04</PageTitle>

<h1>BESHStat shared Excel application layer</h1>

<p>
    Stage 3.04 proves that the generic shared-analysis boundary supports more than one
    analysis family. One-way ANOVA and Kruskal-Wallis now use the same host-neutral
    request/result contracts from both Office.js and the Windows Excel-DNA host.
</p>

<div class="alert @(officeHost?.IsExcel == true ? "alert-success" : "alert-secondary")">
    <strong>Office host:</strong> @officeStatus
    @if (hostCapabilities is not null)
    {
        <div><small>Available operations: @string.Join(", ", hostCapabilities.Capabilities ?? new List<string>())</small></div>
    }
</div>

<details class="mb-3">
    <summary>Developer demo: composite output (02.07)</summary>
    <p>Synthetic fixture only. Creates a new empty worksheet at C10 with tables, a warning,
        a chart placeholder, an additional note and an inactive HTTPS link. Fixed block dimensions;
        long text may clip visually but remains stored in full. This does not run an analysis.</p>
    <button class="btn btn-outline-secondary" @onclick="WriteCompositeDemo" disabled="@(isBusy || !CanRunSelectedDestination)">Write synthetic composite to new worksheet</button>
    @if (compositeTrace is not null)
    {
        <pre>@compositeTrace</pre>
    }
</details>

<div class="mb-3">
    <button class="btn btn-outline-secondary me-2" @onclick="RefreshOfficeStatus">
        Check Excel host
    </button>
    <button class="btn btn-outline-primary me-2" @onclick="ReadSelection" disabled="@(isBusy || !CanReadSelection)">
        Read source range
    </button>
    <button class="btn btn-outline-primary me-2" @onclick="ReadSelectedAreas" disabled="@(isBusy || !CanReadSelection)">
        Read selected areas (01.09)
    </button>
    <button class="btn btn-primary" @onclick="RunSharedAnalysisAndWrite" disabled="@(isBusy || !CanRunSelectedDestination)">
        Run shared analysis and write result
    </button>
</div>

<div class="card mb-3" style="max-width: 1000px;">
    <div class="card-body">
        <h5 class="card-title">Source range (optional)</h5>
        <p class="small text-muted">Leave both fields empty to use the selected Excel range. Otherwise enter a worksheet name (for example <code>Hárok1</code>) and an A1 address (<code>A1:C4</code>), or leave the worksheet name empty and enter <code>'Hárok1'!A1:C4</code> in the address field. A qualified reference pasted into the worksheet field is also accepted when the two fields agree.</p>
        <div class="row g-2">
            <div class="col-md-5">
                <label class="form-label">Worksheet name</label>
                <input class="form-control" @bind="sourceWorksheetName" placeholder="Study Data" />
            </div>
            <div class="col-md-5">
                <label class="form-label">A1 address</label>
                <input class="form-control" @bind="sourceAddress" placeholder="B2:D12" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3" style="max-width: 1000px;">
    <div class="card-body">
        <div class="form-check">
            <input id="configurableParsing" class="form-check-input" type="checkbox" @bind="useConfiguredParsing" />
            <label class="form-check-label" for="configurableParsing">Use configurable grouped-input interpretation (Phase 01.03 preview)</label>
        </div>
        @if (useConfiguredParsing)
        {
            <p class="small text-muted mt-2">Opt-in test of the shared validation and orientation policies. The default unchecked path still uses the original Stage 3.04 parser.</p>
            <div class="row g-2 mt-1">
                <div class="col-md-4">
                    <label class="form-label">Group arrangement</label>
                    <select class="form-select" @bind="groupOrientation">
                        <option value="@SpreadsheetGroupedOrientation.GroupsInColumns">Groups in columns</option>
                        <option value="@SpreadsheetGroupedOrientation.GroupsInRows">Groups in rows</option>
                        <option value="@SpreadsheetGroupedOrientation.LongFormat">Long (category + value)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Header policy</label>
                    <select class="form-select" @bind="groupHeaderMode">
                        <option value="@SpreadsheetHeaderMode.Required">Header required</option>
                        <option value="@SpreadsheetHeaderMode.None">No header</option>
                        <option value="@SpreadsheetHeaderMode.Auto">Auto (reject ambiguous)</option>
                    </select>
                </div>
                @if (groupOrientation == SpreadsheetGroupedOrientation.LongFormat)
                {
                    <div class="col-md-2">
                        <label class="form-label">Category column (1-based)</label>
                        <input class="form-control" type="number" min="1" @bind="categoryColumn" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Value column (1-based)</label>
                        <input class="form-control" type="number" min="1" @bind="valueColumn" />
                    </div>
                }
            </div>
        }
    </div>
</div>

<p><strong>Status:</strong> @status</p>

@if (selectedAreas is not null)
{
    <div class="card mb-3" style="max-width: 1000px;">
        <div class="card-body">
            <h5 class="card-title">Selected areas preview (01.09)</h5>
            <p><strong>Ranges:</strong> @selectedAreas.Ranges.Count</p>
            <p class="small text-muted">Current Excel selection in the order reported by the host. Areas are previewed separately; this read does not run an analysis. The optional source fields apply only to the single-range operations.</p>
            @for (var rangeIndex = 0; rangeIndex < selectedAreas.Ranges.Count; rangeIndex++)
            {
                var area = selectedAreas.Ranges[rangeIndex];
                <h6>Range @(rangeIndex + 1): @area.WorksheetName — @area.Address</h6>
                <p class="small">@area.RowCount rows × @area.ColumnCount columns; top-left row @area.StartRow, column @area.StartColumn.</p>
                <div class="table-responsive mb-3" style="max-height: 280px; overflow-y: auto;">
                    <table class="table table-sm table-bordered mb-0">
                        <thead><tr><th>Cell</th><th>Kind</th><th>Underlying value</th><th>Number format</th></tr></thead>
                        <tbody>
                            @foreach (var sourceCell in PreviewSourceCells(area, int.MaxValue))
                            {
                                <tr>
                                    <td><code>@sourceCell.Address</code></td>
                                    <td>@sourceCell.Kind</td>
                                    <td>@sourceCell.Value</td>
                                    <td><code>@sourceCell.NumberFormat</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (selection is not null)
{
    var sourceCells = PreviewSourceCells(selection, 60);
    <div class="card mb-3" style="max-width: 1000px;">
        <div class="card-body">
            <h5 class="card-title">Raw Excel cell kinds (before analysis parsing)</h5>
            <p class="small mb-2">
                <strong>Source:</strong> @selection.QualifiedAddress
                (@selection.RowCount rows × @selection.ColumnCount columns).
                <strong>Date system:</strong> @selection.DateSystem.
            </p>
            <p class="small text-muted mb-2">
                This is the typed snapshot returned by Office.js, not a result of numeric coercion.
                A date-formatted number remains <code>Number (1)</code>; an Excel error is
                <code>CellError (4)</code>, while literal error-looking text is <code>Text (2)</code>.
            </p>
            @if (groupedIssues is not null && groupedIssues.Count > 0)
            {
                <div class="mb-2">
                    <strong class="small">Structured grouped-input diagnostics:</strong>
                    <ul class="small mb-0">
                        @foreach (var issue in groupedIssues.Take(12))
                        {
                            <li><code>@issue.Code</code> (@issue.Severity): @issue.Message
                                @if (issue.SelectedRow > 0)
                                {
                                    <span> — selected row @issue.SelectedRow, column @issue.SelectedColumn</span>
                                }
                                @if (issue.WorksheetRow > 0 && issue.WorksheetColumn > 0)
                                {
                                    <span> (worksheet row @issue.WorksheetRow, column @issue.WorksheetColumn)</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(groupedValidationMessage))
            {
                <div class="alert alert-warning py-2 mb-2">
                    <strong>Grouped-analysis validation:</strong> @groupedValidationMessage
                    <div class="small mt-1">The source read succeeded. This range is not valid ANOVA/Kruskal–Wallis input; the raw cell kinds below are still available for inspection.</div>
                </div>
            }
            <div class="table-responsive" style="max-height: 280px; overflow-y: auto;">
                <table class="table table-sm table-bordered mb-0">
                    <thead><tr><th>Cell</th><th>Kind</th><th>Underlying value</th><th>Number format</th></tr></thead>
                    <tbody>
                        @foreach (var sourceCell in sourceCells)
                        {
                            <tr class="@(sourceCell.IsInvalidGroupedObservation ? "table-warning" : "")">
                                <td><code>@sourceCell.Address</code></td>
                                <td>@sourceCell.Kind</td>
                                <td>@sourceCell.Value</td>
                                <td><code>@sourceCell.NumberFormat</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if ((long)selection.RowCount * selection.ColumnCount > sourceCells.Count)
            {
                <p class="small text-muted mt-2 mb-0">Preview limited to the first @sourceCells.Count cells. Select a smaller range to inspect later cells.</p>
            }
            <p class="small text-muted mt-2 mb-0">Highlighted rows contain a nonnumeric/nonblank observation after the first header row and are not accepted by the legacy grouped parser.</p>
        </div>
    </div>
}

<div class="card mb-4" style="max-width: 1000px;">
    <div class="card-body">
        <h5 class="card-title">Shared analysis options</h5>
        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label">Analysis</label>
                <select class="form-select" @bind="analysisKind">
                    @foreach (var descriptor in AnalysisCatalog.All)
                    {
                        if (descriptor.LegacyKind.HasValue)
                        {
                            <option value="@descriptor.LegacyKind.Value">@descriptor.DisplayName</option>
                        }
                    }
                </select>
            </div>
        </div>

        @if (analysisKind == SpreadsheetAnalysisKind.OneWayAnova)
        {
            <div class="form-check mt-3">
                <input class="form-check-input" type="checkbox" @bind="includeWelch" id="welchCheck" />
                <label class="form-check-label" for="welchCheck">
                    Include Welch ANOVA columns in the primary result table
                </label>
            </div>
        }
        else if (analysisKind == SpreadsheetAnalysisKind.KruskalWallis)
        {
            <div class="form-check mt-3">
                <input class="form-check-input" type="checkbox" @bind="includeDunn" id="dunnCheck" />
                <label class="form-check-label" for="dunnCheck">
                    Include Dunn's Bonferroni-adjusted pairwise comparisons
                </label>
            </div>
        }

        <hr />

        <h5 class="card-title">Shared writer options</h5>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Output destination</label>
                <select class="form-select" @bind="outputDestination">
                    <option value="@SpreadsheetOutputDestination.NewWorksheet" disabled="@(!SupportsDestination(SpreadsheetOutputDestination.NewWorksheet))">New worksheet</option>
                    <option value="@SpreadsheetOutputDestination.CurrentWorksheet" disabled="@(!SupportsDestination(SpreadsheetOutputDestination.CurrentWorksheet))">Current worksheet</option>
                    <option value="@SpreadsheetOutputDestination.NewWorkbook" disabled="@(!SupportsDestination(SpreadsheetOutputDestination.NewWorkbook))">New workbook (unavailable in Office.js)</option>
                </select>
                @if (!SupportsDestination(outputDestination))
                {
                    <small class="text-danger">This destination is unavailable in the current host. Select a supported worksheet destination explicitly.</small>
                }
            </div>

            <div class="col-md-4">
                <label class="form-label">Worksheet name</label>
                <input class="form-control" @bind="outputWorksheetName" disabled="@(outputDestination != SpreadsheetOutputDestination.NewWorksheet)" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Start row</label>
                <input class="form-control" type="number" min="1" @bind="outputStartRow" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Start column</label>
                <input class="form-control" type="number" min="1" @bind="outputStartColumn" />
            </div>
        </div>

        <hr />

        <h6>P-value presentation passed to the host writer</h6>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Decimal places</label>
                <input class="form-control" type="number"
                       min="@PValuePresentationSettings.MinimumDecimalPlaces"
                       max="@PValuePresentationSettings.MaximumDecimalPlaces"
                       @bind="pvalueDecimalPlaces" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Very small p-values</label>
                <select class="form-select" @bind="pvalueSmallValueDisplay">
                    <option value="@PValueSmallValueDisplay.LessThanThreshold">&lt; threshold</option>
                    <option value="@PValueSmallValueDisplay.ScientificNotation">Scientific notation</option>
                    <option value="@PValueSmallValueDisplay.FixedDecimal">Fixed decimal</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Alpha</label>
                <input class="form-control" type="number" min="0.0001" max="0.9999" step="0.01" @bind="pvalueHighlightAlpha" />
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" @bind="pvalueUseUpperBound" id="upperBoundCheck" />
                    <label class="form-check-label" for="upperBoundCheck">Show &gt; upper threshold</label>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4" style="max-width: 1000px;">
    <div class="card-body">
        <h5 class="card-title">Expected Excel input</h5>
        <p class="card-text mb-2">
            Select one rectangular range, or specify its worksheet and A1 address above. The first row contains group names; each remaining
            column contains numeric observations for that group. Blank data cells are ignored.
            The original grouped-data parser is the default for both families. Enable the optional Phase 01.03 preview above to test other orientations and header policies.
        </p>

        @if (analysisKind == SpreadsheetAnalysisKind.OneWayAnova)
        {
            <table class="table table-bordered table-sm mb-0" style="max-width: 420px;">
                <thead><tr><th>Group A</th><th>Group B</th><th>Group C</th></tr></thead>
                <tbody>
                    <tr><td>1</td><td>2</td><td>5</td></tr>
                    <tr><td>2</td><td>3</td><td>6</td></tr>
                    <tr><td>3</td><td>4</td><td>7</td></tr>
                </tbody>
            </table>
        }
        else
        {
            <table class="table table-bordered table-sm mb-0" style="max-width: 420px;">
                <thead><tr><th>A</th><th>B</th><th>C</th></tr></thead>
                <tbody>
                    <tr><td>1</td><td>2</td><td>4</td></tr>
                    <tr><td>2</td><td>3</td><td>5</td></tr>
                    <tr><td>2</td><td>4</td><td>5</td></tr>
                    <tr><td>3</td><td>4</td><td>6</td></tr>
                </tbody>
            </table>
        }
    </div>
</div>

@if (selection is not null)
{
    <div class="mb-4">
        <h3>Selected Excel data</h3>
        <p>
            <strong>Worksheet:</strong> @selection.WorksheetName<br />
            <strong>Range:</strong> @selection.QualifiedAddress<br />
            <strong>Worksheet identity:</strong> @selection.WorksheetId<br />
            <strong>Top-left cell:</strong> row @selection.StartRow, column @selection.StartColumn
        </p>

        @if (groupedPreview is not null)
        {
            <p>
                <strong>Shared parser:</strong>
                @string.Join(", ", groupedPreview.GroupNames.Select((name, index) => $"{name} (n={groupedPreview.Groups[index].Length})"))
            </p>
        }
    </div>
}

@if (sharedOutput is not null)
{
    <div class="mt-4">
        <h3>BESHStat.Core @AnalysisDisplayName(sharedOutput.AnalysisKind) result</h3>

        @if (anovaOutput is not null)
        {
            <p>
                <strong>F:</strong> @anovaOutput.FStatistic.ToString("G12", CultureInfo.InvariantCulture)<br />
                <strong>p-value:</strong> @anovaOutput.PValue.ToString("G12", CultureInfo.InvariantCulture)
            </p>

            @if (anovaOutput.HasWelch)
            {
                <p>
                    <strong>Welch F:</strong> @anovaOutput.WelchFStatistic.ToString("G12", CultureInfo.InvariantCulture)<br />
                    <strong>Welch denominator df:</strong> @anovaOutput.WelchDenominatorDf.ToString("G12", CultureInfo.InvariantCulture)<br />
                    <strong>Welch p-value:</strong> @anovaOutput.WelchPValue.ToString("G12", CultureInfo.InvariantCulture)
                </p>
            }
        }
        else if (kruskalOutput is not null)
        {
            <p>
                <strong>H:</strong> @kruskalOutput.HStatistic.ToString("G12", CultureInfo.InvariantCulture)<br />
                <strong>p-value:</strong> @kruskalOutput.PValue.ToString("G12", CultureInfo.InvariantCulture)<br />
                <strong>Tie-corrected H:</strong> @kruskalOutput.TieCorrectedHStatistic.ToString("G12", CultureInfo.InvariantCulture)<br />
                <strong>Tie-corrected p-value:</strong> @kruskalOutput.TieCorrectedPValue.ToString("G12", CultureInfo.InvariantCulture)
            </p>
        }

        @for (var tableIndex = 0; tableIndex < sharedOutput.Tables.Count; tableIndex++)
        {
            var table = sharedOutput.Tables[tableIndex];
            if (sharedOutput.Tables.Count > 1)
            {
                <h5 class="mt-4">Result table @(tableIndex + 1)</h5>
            }

            <table class="table table-bordered table-sm" style="max-width: 950px;">
                <tbody>
                    @for (var row = 0; row < table.RowCount; row++)
                    {
                        <tr>
                            @for (var col = 0; col < table.ColumnCount; col++)
                            {
                                if (IsHeaderCell(table, row, col))
                                {
                                    <th>@FormatCell(table.Values[row, col])</th>
                                }
                                else
                                {
                                    <td>@FormatCell(table.Values[row, col])</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (writeResult is not null)
        {
            <p class="alert alert-success" style="max-width: 950px;">
                Excel output written to <strong>@writeResult.WorksheetName</strong>
                at <strong>@writeResult.Address</strong>.<br />
                <small>@writeResult.TableAddresses.Length table(s) written through the generic Office.js batch writer.</small><br />
                <small>Shared p-value number format: <code>@writeResult.PvalueNumberFormat</code></small>
            </p>
        }
    </div>
}

@code {
    private string? compositeTrace;

    private async Task WriteCompositeDemo()
    {
        try
        {
            isBusy = true;
            var host = await JS.InvokeAsync<HostCapabilitySnapshot>("beshOffice.getHostCapabilities");
            var decision = TargetPlanner.Create(new SpreadsheetOutputTarget {
                Destination = SpreadsheetOutputDestination.NewWorksheet, WorksheetName = "BESHStat_Composite_Demo",
                StartRow = 10, StartColumn = 3 }, host);
            var plan = CompositeOutputExample.Create(decision);
            var wire = OfficeCompositeOutputPlanAdapter.Prepare(plan, OutputSemanticPlanner.Create(plan.SourceDocument, null, 0.05));
            var result = await JS.InvokeAsync<System.Text.Json.JsonElement>("beshOffice.writeCompositeOutputPlan", wire);
            compositeTrace = System.Text.Json.JsonSerializer.Serialize(result, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            status = "Synthetic composite written; chart not rendered and links inactive. Inspect addresses and stored text in Excel.";
        }
        catch (Exception ex)
        {
            compositeTrace = null;
            status = "Composite failed: " + ReadErrorMessage(ex) + " A new worksheet or partial output may remain; no rollback is provided.";
        }
        finally { isBusy = false; }
    }
    private OfficeHostStatus? officeHost;
    private HostCapabilitySnapshot? hostCapabilities;
    private bool CanReadSelection => hostCapabilities?.Supports(HostCapabilityIds.ReadSelectedRange) == true;
    private bool CanRunSelectedDestination => CanReadSelection &&
        hostCapabilities?.Supports(HostCapabilityIds.WriteResultTables) == true && SupportsDestination(outputDestination);

    private bool SupportsDestination(SpreadsheetOutputDestination destination)
    {
        var capability = HostCapabilityIds.ForDestination(destination);
        return capability is not null && hostCapabilities?.Supports(capability) == true;
    }

    private SpreadsheetRangeData? selection;
    private SpreadsheetRangeSetData? selectedAreas;
    private string sourceWorksheetName = string.Empty;
    private string sourceAddress = string.Empty;

    private async Task<SpreadsheetRangeData> AcquireRangeAsync()
    {
        if (string.IsNullOrWhiteSpace(sourceAddress) && string.IsNullOrWhiteSpace(sourceWorksheetName))
            return await JS.InvokeAsync<SpreadsheetRangeData>("beshOffice.getSelectedRangeData");
        var reference = SpreadsheetRangeReference.FromUserInput(sourceWorksheetName, sourceAddress);
        return await JS.InvokeAsync<SpreadsheetRangeData>("beshOffice.getRangeDataByReference", reference);
    }
    private bool useConfiguredParsing;
    private SpreadsheetGroupedOrientation groupOrientation = SpreadsheetGroupedOrientation.GroupsInColumns;
    private SpreadsheetHeaderMode groupHeaderMode = SpreadsheetHeaderMode.Required;
    private int categoryColumn = 1;
    private int valueColumn = 2;
    private List<SpreadsheetValidationIssue>? groupedIssues;

    private SpreadsheetGroupedParseOptions MakeGroupedOptions() => new()
    {
        Orientation = groupOrientation,
        Header = groupHeaderMode,
        CategoryColumnIndex = categoryColumn - 1,
        ValueColumnIndex = valueColumn - 1
    };

    private GroupedNumericData ParseSelectedInput(SpreadsheetRangeData source)
    {
        groupedIssues = null;
        if (!useConfiguredParsing)
            return GroupedNumericRangeParser.Parse(source);

        var parsed = GroupedNumericRangeParser.ParseWithDiagnostics(source, MakeGroupedOptions());
        groupedIssues = parsed.Validation.Issues.ToList();
        if (!parsed.Success)
            throw new SpreadsheetInputValidationException(parsed.Validation);
        return parsed.Data;
    }

    private string? groupedValidationMessage;
    private GroupedNumericData? groupedPreview;
    private SpreadsheetAnalysisResult? sharedOutput;
    private OneWayAnovaApplicationResult? anovaOutput;
    private KruskalWallisApplicationResult? kruskalOutput;
    private OfficeWriteResult? writeResult;

    private string officeStatus = "Checking...";
    private string status = "Select a range in Excel, choose an analysis, then run the Stage 3.04 shared-layer test.";
    private bool isBusy;

    private SpreadsheetAnalysisKind analysisKind = SpreadsheetAnalysisKind.OneWayAnova;
    private SpreadsheetOutputDestination outputDestination = SpreadsheetOutputDestination.NewWorksheet;
    private string outputWorksheetName = "BESHStat_WASM_Result";
    private int outputStartRow = 1;
    private int outputStartColumn = 1;

    private int pvalueDecimalPlaces = PValuePresentationSettings.DefaultDecimalPlaces;
    private PValueSmallValueDisplay pvalueSmallValueDisplay = PValueSmallValueDisplay.LessThanThreshold;
    private bool pvalueUseUpperBound = true;
    private double pvalueHighlightAlpha = 0.05;
    private bool includeWelch;
    private bool includeDunn = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await RefreshOfficeStatus();
        StateHasChanged();
    }

    private async Task RefreshOfficeStatus()
    {
        try
        {
            officeHost = await JS.InvokeAsync<OfficeHostStatus>("beshOffice.getHostStatus", 2500);
            hostCapabilities = await JS.InvokeAsync<HostCapabilitySnapshot>("beshOffice.getHostCapabilities");
            officeStatus = officeHost.Message;

            if (officeHost.IsExcel)
            {
                var details = new List<string>();
                if (!string.IsNullOrWhiteSpace(officeHost.Host))
                    details.Add(officeHost.Host);
                if (!string.IsNullOrWhiteSpace(officeHost.Platform))
                    details.Add(officeHost.Platform);

                if (details.Count > 0)
                    officeStatus += " " + string.Join(" / ", details) + ".";
            }
        }
        catch (Exception ex)
        {
            officeHost = null;
            hostCapabilities = null;
            officeStatus = "Unable to query Office.js: " + ex.Message;
        }
    }

    private async Task ReadSelection()
    {
        try
        {
            isBusy = true;
            selection = null;
            selectedAreas = null;
            groupedPreview = null;
            groupedValidationMessage = null;
            groupedIssues = null;
            sharedOutput = null;
            anovaOutput = null;
            kruskalOutput = null;
            writeResult = null;

            hostCapabilities = await JS.InvokeAsync<HostCapabilitySnapshot>("beshOffice.getHostCapabilities");
            HostCapabilityPreflight.CheckSelection(hostCapabilities).EnsureSupported();
            selection = await AcquireRangeAsync();

            // A successful read must remain inspectable even when a grouped analysis
            // correctly rejects error, text, or Boolean observations.
            try
            {
                groupedPreview = ParseSelectedInput(selection);
                status = $"PASS — acquired typed cells from {selection.Address}; grouped analysis input is valid.";
            }
            catch (ArgumentException ex)
            {
                groupedValidationMessage = ex.Message;
                status = $"PASS — acquired typed cells from {selection.Address}; grouped-analysis validation failed (see preview).";
            }
        }
        catch (Exception ex)
        {
            selection = null;
            groupedPreview = null;
            groupedValidationMessage = null;
            groupedIssues = null;
            status = "FAIL — unable to read the source range: " + ReadErrorMessage(ex);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ReadSelectedAreas()
    {
        try
        {
            isBusy = true;
            selectedAreas = null;
            selection = null;
            groupedPreview = null;
            groupedValidationMessage = null;
            groupedIssues = null;
            sharedOutput = null;
            anovaOutput = null;
            kruskalOutput = null;
            writeResult = null;

            hostCapabilities = await JS.InvokeAsync<HostCapabilitySnapshot>("beshOffice.getHostCapabilities");
            HostCapabilityPreflight.CheckSelection(hostCapabilities).EnsureSupported();
            selectedAreas = await JS.InvokeAsync<SpreadsheetRangeSetData>("beshOffice.getSelectedRangeSetData");
            if (selectedAreas?.Ranges is not { Count: > 0 })
                throw new InvalidOperationException("Excel returned no selected areas. Select worksheet cells and try again.");
            status = $"PASS — acquired {selectedAreas.Ranges.Count} selected range(s); see the separate area previews.";
        }
        catch (Exception ex)
        {
            selectedAreas = null;
            status = "FAIL — unable to read selected areas: " + ReadErrorMessage(ex);
        }
        finally
        {
            isBusy = false;
        }
    }

    // JS interop appends a JavaScript stack to Message. Show the bridge's concise
    // explanation while retaining normal .NET validation messages unchanged.
    private static string ReadErrorMessage(Exception error) => error is JSException
        ? error.Message.Split('\n', 2)[0].TrimEnd('\r')
        : error.Message;

    private async Task RunSharedAnalysisAndWrite()
    {
        try
        {
            isBusy = true;
            writeResult = null;
            selection = null;
            selectedAreas = null;
            groupedPreview = null;
            groupedValidationMessage = null;
            groupedIssues = null;

            // Preflight MUST run before reading the selection or running the statistical engine.
            hostCapabilities = await JS.InvokeAsync<HostCapabilitySnapshot>("beshOffice.getHostCapabilities");
            var target = new SpreadsheetOutputTarget
            {
                Destination = outputDestination,
                WorksheetName = outputWorksheetName,
                StartRow = outputStartRow,
                StartColumn = outputStartColumn
            };
            var analysisId = AnalysisCatalog.GetByLegacyKind(analysisKind).Id;
            HostCapabilityPreflight.CheckRunAndWrite(analysisId, hostCapabilities, target).EnsureSupported();
            var targetDecision = TargetPlanner.Create(target, hostCapabilities);
            target = targetDecision.ToTarget(); // preserves both one-based inputs; no fallback/default repair

            selection = await AcquireRangeAsync();
            groupedPreview = ParseSelectedInput(selection);

            SpreadsheetAnalysisOptions options;
            switch (analysisKind)
            {
                case SpreadsheetAnalysisKind.OneWayAnova:
                    options = new OneWayAnovaAnalysisOptions
                    {
                        IncludeWelch = includeWelch,
                        Alpha = pvalueHighlightAlpha
                    };
                    break;

                case SpreadsheetAnalysisKind.KruskalWallis:
                    options = new KruskalWallisAnalysisOptions
                    {
                        IncludeDunnComparisons = includeDunn,
                        Alpha = pvalueHighlightAlpha
                    };
                    break;

                default:
                    throw new NotSupportedException($"Unsupported shared analysis kind: {analysisKind}.");
            }

            // The Office prototype exercises the stable-ID facade while the Windows
            // Excel-DNA caller retains the original enum-based request facade.
            SpreadsheetAnalysisInput analysisInput = useConfiguredParsing ? groupedPreview! : selection;
            sharedOutput = SharedAnalysisApplicationService.Run(analysisId, analysisInput, options);
            anovaOutput = sharedOutput.Detail as OneWayAnovaApplicationResult;
            kruskalOutput = sharedOutput.Detail as KruskalWallisApplicationResult;

            var settings = new PValuePresentationSettings
            {
                DecimalPlaces = pvalueDecimalPlaces,
                SmallValueDisplay = pvalueSmallValueDisplay,
                UseUpperBound = pvalueUseUpperBound
            };
            settings.EnsureDefaults();

            var document = OutputDocument.FromResult(sharedOutput);
            var semantics = OutputSemanticPlanner.Create(document, settings, pvalueHighlightAlpha);
            var layout = OutputLayoutPlanner.Create(document, target,
                new OutputLayoutOptions(blankRowsBetweenTables: 1), semanticPlan: semantics);
            var preparedPlan = OfficeOutputPlanAdapter.Prepare(document, semantics, layout);

            if (preparedPlan.TableCount == 0)
                throw new InvalidOperationException("The shared analysis returned no result tables.");

            writeResult = await JS.InvokeAsync<OfficeWriteResult>("beshOffice.writeOutputPlan", preparedPlan);
            status = BuildSuccessStatus();
        }
        catch (Exception ex)
        {
            if (selection is not null && groupedPreview is null && ex is ArgumentException)
                groupedValidationMessage = ex.Message;
            sharedOutput = null;
            anovaOutput = null;
            kruskalOutput = null;
            writeResult = null;
            status = "FAIL — " + ReadErrorMessage(ex);
        }
        finally
        {
            isBusy = false;
        }
    }

    private string BuildSuccessStatus()
    {
        if (anovaOutput is not null)
        {
            var welchStatus = anovaOutput.HasWelch
                ? $" Welch F = {anovaOutput.WelchFStatistic:G12}; Welch p = {anovaOutput.WelchPValue:G12}."
                : string.Empty;

            return $"PASS — generic shared dispatcher ran one-way ANOVA and the Office.js batch writer returned all shared tables. " +
                   $"F = {anovaOutput.FStatistic:G12}; p = {anovaOutput.PValue:G12}." + welchStatus;
        }

        if (kruskalOutput is not null)
        {
            return $"PASS — generic shared dispatcher ran Kruskal-Wallis and the Office.js batch writer returned all shared tables. " +
                   $"H = {kruskalOutput.HStatistic:G12}; tie-corrected H = {kruskalOutput.TieCorrectedHStatistic:G12}; " +
                   $"tie-corrected p = {kruskalOutput.TieCorrectedPValue:G12}.";
        }

        return "PASS — shared analysis completed and result tables were written to Excel.";
    }

    private sealed record SourceCellPreview(string Address, string Kind, string Value,
                                             string NumberFormat, bool IsInvalidGroupedObservation);

    private static List<SourceCellPreview> PreviewSourceCells(SpreadsheetRangeData source, int maximum)
    {
        var cells = new List<SourceCellPreview>();
        if (source.Rows is null) return cells;
        for (var row = 0; row < source.Rows.Count && cells.Count < maximum; row++)
        {
            var values = source.Rows[row];
            if (values is null) continue;
            for (var column = 0; column < values.Count && cells.Count < maximum; column++)
            {
                var cell = values[column];
                var kind = cell is null ? "Null" : $"{cell.Kind} ({(int)cell.Kind})";
                var value = cell is null ? "<null>" : cell.Kind switch
                {
                    SpreadsheetCellKind.Blank => "<blank>",
                    SpreadsheetCellKind.Number => cell.NumberValue.ToString("G17", CultureInfo.InvariantCulture),
                    SpreadsheetCellKind.Bool => cell.BooleanValue ? "TRUE" : "FALSE",
                    SpreadsheetCellKind.Text => cell.TextValue?.Length > 0 ? cell.TextValue : "<empty text>",
                    SpreadsheetCellKind.CellError => cell.TextValue ?? "<error>",
                    _ => "<unknown>"
                };
                var rowNumber = source.StartRow > 0 ? source.StartRow + row : row + 1;
                var columnNumber = source.StartColumn > 0 ? source.StartColumn + column : column + 1;
                cells.Add(new SourceCellPreview(
                    ExcelColumnLabel(columnNumber) + rowNumber.ToString(CultureInfo.InvariantCulture),
                    kind, value, cell?.NumberFormat ?? string.Empty,
                    row > 0 && (cell is null || (cell.Kind != SpreadsheetCellKind.Blank &&
                                                 cell.Kind != SpreadsheetCellKind.Number))));
            }
        }
        return cells;
    }

    private static string ExcelColumnLabel(int column)
    {
        var label = string.Empty;
        while (column > 0)
        {
            column--;
            label = (char)('A' + column % 26) + label;
            column /= 26;
        }
        return label;
    }

    private static string AnalysisDisplayName(SpreadsheetAnalysisKind kind)
    {
        foreach (var descriptor in AnalysisCatalog.All)
        {
            if (descriptor.LegacyKind == kind)
                return descriptor.DisplayName;
        }

        return kind.ToString();
    }

    private static bool IsHeaderCell(ResultTableOutputModel model, int row, int col)
    {
        var topHeaderEnd = model.TitleRows + model.HeaderTopRows;
        if (row < topHeaderEnd)
            return true;

        return col < model.HeaderLeftColumns &&
               row < model.RowCount - model.FooterRows;
    }

    private static string FormatCell(object? value)
    {
        if (value is null)
            return string.Empty;

        if (value is double d)
            return d.ToString("G12", CultureInfo.InvariantCulture);

        if (value is float f)
            return f.ToString("G9", CultureInfo.InvariantCulture);

        return Convert.ToString(value, CultureInfo.InvariantCulture) ?? string.Empty;
    }

    private sealed class OfficeHostStatus
    {
        public bool OfficeJsLoaded { get; set; }
        public bool IsExcel { get; set; }
        public string Host { get; set; } = string.Empty;
        public string Platform { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
    }

    private sealed class OfficeWriteResult
    {
        public string WorksheetName { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string[] TableAddresses { get; set; } = Array.Empty<string>();
        public int[] PvalueColumns { get; set; } = Array.Empty<int>();
        public string PvalueNumberFormat { get; set; } = string.Empty;
    }
