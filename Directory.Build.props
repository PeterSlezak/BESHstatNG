<Project>
  <PropertyGroup>
    <!-- Single source of truth (4-part) -->
    <BeshVersion>1.2.6.0</BeshVersion>

    <!-- .NET versioning -->
    <Version>$(BeshVersion)</Version>
    <AssemblyVersion>$(BeshVersion)</AssemblyVersion>
    <FileVersion>$(BeshVersion)</FileVersion>
    <InformationalVersion>$(BeshVersion)</InformationalVersion>

    <!-- Derive MSI 3-part version (drop the 4th part) -->
    <BeshVersion3>$([System.Version]::Parse('$(BeshVersion)').ToString(3))</BeshVersion3>

    <!-- Docs version folder (pick one) -->
    <HelpVersion>v$(BeshVersion)</HelpVersion>
    <!-- or if you prefer docs per MSI version: v$(BeshVersion3) -->

    <!-- Enable only AFTER the owner publishes and verifies the documentation resolver.
         Shared Common build flag applies equally to Windows and the WASM pilot. -->
    <BeshHelpResolverPublished Condition="'$(BeshHelpResolverPublished)' == ''">true</BeshHelpResolverPublished>
  </PropertyGroup>
</Project>
