<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest" Version="3.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BESHStat.Excel.Common\BESHStat.Excel.Common.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\BESHStat.WasmSmoke\tests\fixtures\output-plans\*.json" Link="TestData\OfficeOutput\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestData\Stage304\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestData\Acquisition\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestData\OutputSemantics\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestData\OutputLayout\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
